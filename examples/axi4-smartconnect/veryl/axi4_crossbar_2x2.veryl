/// AXI4 channels shared by initiators, targets, and verification wrappers.
interface Axi4Interface::<ADDR_WIDTH: u32 = 16, DATA_WIDTH: u32 = 32, ID_WIDTH: u32 = 4> {
    var awid    : logic<ID_WIDTH>      ;
    var awaddr  : logic<ADDR_WIDTH>    ;
    var awlen   : logic<8>             ;
    var awsize  : logic<3>             ;
    var awburst : logic<2>             ;
    var awlock  : logic                ;
    var awcache : logic<4>             ;
    var awprot  : logic<3>             ;
    var awqos   : logic<4>             ;
    var awregion: logic<4>             ;
    var awvalid : logic                ;
    var awready : logic                ;
    var wdata   : logic<DATA_WIDTH>    ;
    var wstrb   : logic<DATA_WIDTH / 8>;
    var wlast   : logic                ;
    var wvalid  : logic                ;
    var wready  : logic                ;
    var bid     : logic<ID_WIDTH>      ;
    var bresp   : logic<2>             ;
    var bvalid  : logic                ;
    var bready  : logic                ;
    var arid    : logic<ID_WIDTH>      ;
    var araddr  : logic<ADDR_WIDTH>    ;
    var arlen   : logic<8>             ;
    var arsize  : logic<3>             ;
    var arburst : logic<2>             ;
    var arlock  : logic                ;
    var arcache : logic<4>             ;
    var arprot  : logic<3>             ;
    var arqos   : logic<4>             ;
    var arregion: logic<4>             ;
    var arvalid : logic                ;
    var arready : logic                ;
    var rid     : logic<ID_WIDTH>      ;
    var rdata   : logic<DATA_WIDTH>    ;
    var rresp   : logic<2>             ;
    var rlast   : logic                ;
    var rvalid  : logic                ;
    var rready  : logic                ;

    modport initiator {
        awid    : output,
        awaddr  : output,
        awlen   : output,
        awsize  : output,
        awburst : output,
        awlock  : output,
        awcache : output,
        awprot  : output,
        awqos   : output,
        awregion: output,
        awvalid : output,
        awready : input ,
        wdata   : output,
        wstrb   : output,
        wlast   : output,
        wvalid  : output,
        wready  : input ,
        bid     : input ,
        bresp   : input ,
        bvalid  : input ,
        bready  : output,
        arid    : output,
        araddr  : output,
        arlen   : output,
        arsize  : output,
        arburst : output,
        arlock  : output,
        arcache : output,
        arprot  : output,
        arqos   : output,
        arregion: output,
        arvalid : output,
        arready : input ,
        rid     : input ,
        rdata   : input ,
        rresp   : input ,
        rlast   : input ,
        rvalid  : input ,
        rready  : output,
    }

    modport target {
        awid    : input ,
        awaddr  : input ,
        awlen   : input ,
        awsize  : input ,
        awburst : input ,
        awlock  : input ,
        awcache : input ,
        awprot  : input ,
        awqos   : input ,
        awregion: input ,
        awvalid : input ,
        awready : output,
        wdata   : input ,
        wstrb   : input ,
        wlast   : input ,
        wvalid  : input ,
        wready  : output,
        bid     : output,
        bresp   : output,
        bvalid  : output,
        bready  : input ,
        arid    : input ,
        araddr  : input ,
        arlen   : input ,
        arsize  : input ,
        arburst : input ,
        arlock  : input ,
        arcache : input ,
        arprot  : input ,
        arqos   : input ,
        arregion: input ,
        arvalid : input ,
        arready : output,
        rid     : output,
        rdata   : output,
        rresp   : output,
        rlast   : output,
        rvalid  : output,
        rready  : input ,
    }
}

/// Validates and decodes a complete AXI4 burst.
///
/// The decoder rejects reserved burst types, transfers wider than the data
/// bus, FIXED bursts longer than 16 beats, invalid WRAP lengths or alignment,
/// address overflow, and any burst crossing a 4 KiB boundary. A transfer is
/// routed only when every byte lies inside one target window.
module Axi4BurstDecoder (
    addr        : input  logic<16>,
    len         : input  logic<8> ,
    size        : input  logic<3> ,
    burst       : input  logic<2> ,
    target0     : output logic    ,
    target1     : output logic    ,
    decode_error: output logic    ,
) {
    var extended_address: logic<17>;
    var aligned_address : logic<17>;
    var beat_bytes      : logic<17>;
    var burst_bytes     : logic<17>;
    var last_address    : logic<17>;
    var protocol_valid  : logic    ;

    always_comb {
        extended_address = {1'b0, addr};
        beat_bytes       = 17'h00001 << size;
        burst_bytes      = ({9'h000, len} + 17'h00001) << size;
        aligned_address  = extended_address & ~(beat_bytes - 17'h00001);
        last_address     = aligned_address + beat_bytes - 17'h00001;
        protocol_valid   = size <= 3'd2;

        case burst {
            2'b00: {
                // FIXED repeats the same aligned transfer footprint.
                protocol_valid = protocol_valid && (len <: 8'd16);
            }
            2'b01: {
                last_address = aligned_address + burst_bytes - 17'h00001;
            }
            2'b10: {
                last_address   = (extended_address & ~(burst_bytes - 17'h00001)) + burst_bytes - 17'h00001;
                protocol_valid = protocol_valid && ((len == 8'd1) || (len == 8'd3) || (len == 8'd7) || (len == 8'd15))
                    && ((extended_address & (beat_bytes - 17'h00001)) == 17'h00000);
            }
            default: {
                protocol_valid = 1'b0;
            }
        }

        protocol_valid = protocol_valid && !last_address[16] && (addr[15:12] == last_address[15:12]);
        target0        = protocol_valid && (addr <: 16'h4000) && (last_address <: 17'h04000);
        target1        = protocol_valid && (addr >= 16'h8000) && (last_address <: 17'h0c000);
        decode_error   = !target0 && !target1;
    }
}

/// Statically elaborated bank of independent burst decoders.
///
/// Veryl expands the parameter-bounded generate loop in analyzer AIR, so Struo
/// receives ordinary instances without generating an intermediate source file.
module Axi4BurstDecoderBank::<PORTS: u32 = 2> (
    addr        : input  logic<PORTS * 16>,
    len         : input  logic<PORTS * 8> ,
    size        : input  logic<PORTS * 3> ,
    burst       : input  logic<PORTS * 2> ,
    target0     : output logic<PORTS>     ,
    target1     : output logic<PORTS>     ,
    decode_error: output logic<PORTS>     ,
) {
    for i in 0..PORTS :decoder {
        inst unit: Axi4BurstDecoder (
            addr        : addr[i * 16+:16],
            len         : len[i * 8+:8]   ,
            size        : size[i * 3+:3]  ,
            burst       : burst[i * 2+:2] ,
            target0     : target0[i]      ,
            target1     : target1[i]      ,
            decode_error: decode_error[i] ,
        );
    }
}

/// Four-cycle burst decoder with an output holding register.
///
/// Only one request is in flight per instance. This deliberately trades
/// address-channel latency for a short, predictable ECP5 critical path while
/// preserving the valid/ready contract when arbitration is backpressured.
module Axi4BurstDecoderPipeline (
    clk         : input  clock_posedge      ,
    rst_n       : input  reset_async_low    ,
    in_valid    : input  logic              ,
    in_ready    : output logic              ,
    addr        : input  logic          <16>,
    len         : input  logic          <8> ,
    size        : input  logic          <3> ,
    burst       : input  logic          <2> ,
    out_valid   : output logic              ,
    out_ready   : input  logic              ,
    target0     : output logic              ,
    target1     : output logic              ,
    decode_error: output logic              ,
) {
    var pre_valid            : logic    ;
    var pre_addr             : logic<16>;
    var pre_len              : logic<8> ;
    var pre_burst            : logic<2> ;
    var pre_size0            : logic    ;
    var pre_size1            : logic    ;
    var pre_size2            : logic    ;
    var stage0_valid         : logic    ;
    var stage0_addr          : logic<16>;
    var stage0_burst         : logic<2> ;
    var stage0_beat_mask     : logic<17>;
    var stage0_burst_mask    : logic<17>;
    var stage0_size_valid    : logic    ;
    var stage0_fixed         : logic    ;
    var stage0_increment     : logic    ;
    var stage0_wrap          : logic    ;
    var stage0_fixed_valid   : logic    ;
    var stage0_wrap_lsb      : logic    ;
    var stage0_wrap_order21  : logic    ;
    var stage0_wrap_order32  : logic    ;
    var stage0_wrap_aligned  : logic    ;
    var stage1_valid         : logic    ;
    var stage1_addr          : logic<16>;
    var stage1_last_base     : logic<17>;
    var stage1_last_mask     : logic<17>;
    var stage1_protocol_valid: logic    ;
    var stage2_valid         : logic    ;
    var stage2_addr          : logic<16>;
    var stage2_last_address  : logic<17>;
    var stage2_protocol_valid: logic    ;
    var input_beat_mask      : logic<17>;
    var input_burst_mask     : logic<17>;
    var input_size_valid     : logic    ;
    var input_fixed_valid    : logic    ;
    var input_wrap_aligned   : logic    ;
    var stage0_aligned       : logic<17>;
    var stage0_last_base     : logic<17>;
    var stage0_last_mask     : logic<17>;
    var stage1_last_address  : logic<17>;
    var stage2_within_4k     : logic    ;

    always_comb {
        // For a 32-bit data bus, legal transfer sizes are one, two, or four
        // bytes. Expanding len this way avoids a variable shifter and two
        // cascaded adders in the first stage.
        input_beat_mask     = 17'h00000;
        input_beat_mask[0]  = pre_size1 || pre_size2;
        input_beat_mask[1]  = pre_size2;
        input_burst_mask    = 17'h00000;
        input_burst_mask[0] = if pre_size0 ? pre_len[0] : 1'b1;
        input_burst_mask[1] = if pre_size0 ? pre_len[1] : if pre_size1 ? pre_len[0] : 1'b1;
        input_burst_mask[2] = if pre_size0 ? pre_len[2] : if pre_size1 ? pre_len[1] : pre_len[0];
        input_burst_mask[3] = if pre_size0 ? pre_len[3] : if pre_size1 ? pre_len[2] : pre_len[1];
        input_burst_mask[4] = if pre_size0 ? pre_len[4] : if pre_size1 ? pre_len[3] : pre_len[2];
        input_burst_mask[5] = if pre_size0 ? pre_len[5] : if pre_size1 ? pre_len[4] : pre_len[3];
        input_burst_mask[6] = if pre_size0 ? pre_len[6] : if pre_size1 ? pre_len[5] : pre_len[4];
        input_burst_mask[7] = if pre_size0 ? pre_len[7] : if pre_size1 ? pre_len[6] : pre_len[5];
        input_burst_mask[8] = if pre_size1 ? pre_len[7] : if pre_size2 ? pre_len[6] : 1'b0;
        input_burst_mask[9] = if pre_size2 ? pre_len[7] : 1'b0;

        input_size_valid   = pre_size0 || pre_size1 || pre_size2;
        input_fixed_valid  = pre_len[7:4] == 4'b0000;
        input_wrap_aligned = 1'b1;
        if pre_size1 {
            input_wrap_aligned = !pre_addr[0];
        } else if pre_size2 {
            input_wrap_aligned = pre_addr[1:0] == 2'b00;
        } else if !pre_size0 {
            input_wrap_aligned = 1'b0;
        }

        stage0_aligned = {1'b0, stage0_addr} & ~stage0_beat_mask;
        case stage0_burst {
            2'b00: {
                stage0_last_base = stage0_aligned;
                stage0_last_mask = stage0_beat_mask;
            }
            2'b01: {
                stage0_last_base = stage0_aligned;
                stage0_last_mask = stage0_burst_mask;
            }
            2'b10: {
                stage0_last_base = {1'b0, stage0_addr} & ~stage0_burst_mask;
                stage0_last_mask = stage0_burst_mask;
            }
            default: {
                stage0_last_base = stage0_aligned;
                stage0_last_mask = 17'b0;
            }
        }

        stage1_last_address = stage1_last_base + stage1_last_mask;
        stage2_within_4k    = !stage2_last_address[16] && (stage2_addr[15:12] == stage2_last_address[15:12]);
        in_ready            = !pre_valid && !stage0_valid && !stage1_valid && !stage2_valid && !out_valid;
    }

    always_ff (clk, rst_n) {
        if_reset {
            pre_valid = 1'b0;
            pre_addr  = 16'b0;
            pre_len   = 8'b0;
            pre_burst = 2'b0;
            pre_size0 = 1'b0;
            pre_size1 = 1'b0;
            pre_size2 = 1'b0;
        } else {
            if pre_valid {
                pre_valid = 1'b0;
            }
            if in_valid && in_ready {
                pre_valid = 1'b1;
                pre_addr  = addr;
                pre_len   = len;
                pre_burst = burst;
                pre_size0 = size == 3'd0;
                pre_size1 = size == 3'd1;
                pre_size2 = size == 3'd2;
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            stage0_valid        = 1'b0;
            stage0_addr         = 16'b0;
            stage0_burst        = 2'b0;
            stage0_beat_mask    = 17'b0;
            stage0_burst_mask   = 17'b0;
            stage0_size_valid   = 1'b0;
            stage0_fixed        = 1'b0;
            stage0_increment    = 1'b0;
            stage0_wrap         = 1'b0;
            stage0_fixed_valid  = 1'b0;
            stage0_wrap_lsb     = 1'b0;
            stage0_wrap_order21 = 1'b0;
            stage0_wrap_order32 = 1'b0;
            stage0_wrap_aligned = 1'b0;
        } else {
            if stage0_valid {
                stage0_valid = 1'b0;
            }
            if pre_valid {
                stage0_valid        = 1'b1;
                stage0_addr         = pre_addr;
                stage0_burst        = pre_burst;
                stage0_beat_mask    = input_beat_mask;
                stage0_burst_mask   = input_burst_mask;
                stage0_size_valid   = input_size_valid;
                stage0_fixed        = pre_burst == 2'b00;
                stage0_increment    = pre_burst == 2'b01;
                stage0_wrap         = pre_burst == 2'b10;
                stage0_fixed_valid  = input_fixed_valid;
                stage0_wrap_lsb     = pre_len[0];
                stage0_wrap_order21 = !pre_len[2] || pre_len[1];
                stage0_wrap_order32 = !pre_len[3] || pre_len[2];
                stage0_wrap_aligned = input_wrap_aligned;
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            stage1_valid          = 1'b0;
            stage1_addr           = 16'b0;
            stage1_last_base      = 17'b0;
            stage1_last_mask      = 17'b0;
            stage1_protocol_valid = 1'b0;
        } else {
            if stage1_valid {
                stage1_valid = 1'b0;
            }
            if stage0_valid {
                stage1_valid          = 1'b1;
                stage1_addr           = stage0_addr;
                stage1_last_base      = stage0_last_base;
                stage1_last_mask      = stage0_last_mask;
                stage1_protocol_valid = stage0_size_valid
                    && ((stage0_fixed && stage0_fixed_valid) || stage0_increment
                        || (stage0_wrap && stage0_fixed_valid && stage0_wrap_lsb && stage0_wrap_order21
                            && stage0_wrap_order32 && stage0_wrap_aligned));
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            stage2_valid          = 1'b0;
            stage2_addr           = 16'b0;
            stage2_last_address   = 17'b0;
            stage2_protocol_valid = 1'b0;
        } else {
            if stage2_valid {
                stage2_valid = 1'b0;
            }
            if stage1_valid {
                stage2_valid          = 1'b1;
                stage2_addr           = stage1_addr;
                stage2_last_address   = stage1_last_address;
                stage2_protocol_valid = stage1_protocol_valid;
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            out_valid    = 1'b0;
            target0      = 1'b0;
            target1      = 1'b0;
            decode_error = 1'b0;
        } else {
            if out_valid && out_ready {
                out_valid = 1'b0;
            }
            if stage2_valid {
                out_valid    = 1'b1;
                target0      = stage2_protocol_valid && stage2_within_4k && (stage2_addr[15:14] == 2'b00)
                    && (stage2_last_address[15:14] == 2'b00);
                target1      = stage2_protocol_valid && stage2_within_4k && (stage2_addr[15:14] == 2'b10)
                    && (stage2_last_address[15:14] == 2'b10);
                decode_error = !(stage2_protocol_valid && stage2_within_4k
                    && (((stage2_addr[15:14] == 2'b00) && (stage2_last_address[15:14] == 2'b00))
                        || ((stage2_addr[15:14] == 2'b10) && (stage2_last_address[15:14] == 2'b10))));
            }
        }
    }
}

/// Locally completes one rejected read burst with DECERR responses.
module Axi4ReadDecodeErrorResponder (
    clk           : input  clock_posedge     ,
    rst_n         : input  reset_async_low   ,
    start_valid   : input  logic             ,
    start_ready   : output logic             ,
    start_id      : input  logic          <4>,
    start_len     : input  logic          <8>,
    response_valid: output logic             ,
    response_ready: input  logic             ,
    response_id   : output logic          <4>,
    response_last : output logic             ,
) {
    var issue    : logic   ;
    var issue_id : logic<4>;
    var issue_len: logic<8>;
    var active   : logic   ;
    var active_id: logic<4>;
    var remaining: logic<8>;

    always_comb {
        start_ready    = !issue && !active;
        response_valid = active;
        response_id    = active_id;
        response_last  = remaining == 8'h00;
    }

    always_ff (clk, rst_n) {
        if_reset {
            issue     = 1'b0;
            issue_id  = 4'b0;
            issue_len = 8'b0;
            active    = 1'b0;
            active_id = 4'b0;
            remaining = 8'b0;
        } else {
            if active {
                if response_ready {
                    if remaining == 8'h00 {
                        active = 1'b0;
                    } else {
                        remaining = remaining - 8'h01;
                    }
                }
            } else if issue {
                issue     = 1'b0;
                active    = 1'b1;
                active_id = issue_id;
                remaining = issue_len;
            } else if start_valid && start_ready {
                issue     = 1'b1;
                issue_id  = start_id;
                issue_len = start_len;
            }
        }
    }
}

/// Pipelines response-ID matching before outstanding slots are released.
module Axi4IdReleasePipeline (
    clk          : input  clock_posedge     ,
    rst_n        : input  reset_async_low   ,
    release_valid: input  logic             ,
    release_id   : input  logic          <4>,
    slot0_valid  : input  logic             ,
    slot0_id     : input  logic          <4>,
    slot1_valid  : input  logic             ,
    slot1_id     : input  logic          <4>,
    match        : output logic          <2>,
) {
    var captured_valid      : logic   ;
    var captured_id         : logic<4>;
    var captured_slot0_valid: logic   ;
    var captured_slot0_id   : logic<4>;
    var captured_slot1_valid: logic   ;
    var captured_slot1_id   : logic<4>;

    always_ff (clk, rst_n) {
        if_reset {
            captured_valid       = 1'b0;
            captured_id          = 4'b0;
            captured_slot0_valid = 1'b0;
            captured_slot0_id    = 4'b0;
            captured_slot1_valid = 1'b0;
            captured_slot1_id    = 4'b0;
        } else {
            captured_valid = release_valid;
            if release_valid {
                captured_id          = release_id;
                captured_slot0_valid = slot0_valid;
                captured_slot0_id    = slot0_id;
                captured_slot1_valid = slot1_valid;
                captured_slot1_id    = slot1_id;
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            match = 2'b0;
        } else {
            match = 2'b0;
            if captured_valid {
                match[0] = captured_slot0_valid && (captured_slot0_id == captured_id);
                match[1] = captured_slot1_valid && (captured_slot1_id == captured_id);
            }
        }
    }
}

/// Selects the highest-QoS request from a statically sized input set.
///
/// `tie_break[challenger * PORTS + candidate]` is asserted when the
/// challenger precedes the candidate at equal QoS. The caller supplies a
/// strict total order, which can be rotated after each grant for fairness.
module Axi4QosArbiter::<PORTS: u32 = 2> (
    request  : input  logic<PORTS>        ,
    qos      : input  logic<PORTS * 4>    ,
    tie_break: input  logic<PORTS * PORTS>,
    grant    : output logic<PORTS>        ,
) {
    always_comb {
        grant = request;
        for candidate in 0..PORTS {
            for challenger in 0..PORTS {
                if candidate != challenger {
                    if request[challenger]
                        && ((qos[challenger * 4+:4] >: qos[candidate * 4+:4])
                            || ((qos[challenger * 4+:4] == qos[candidate * 4+:4])
                                && tie_break[challenger * PORTS + candidate])) {
                        grant[candidate] = 1'b0;
                    }
                }
            }
        }
    }
}

/// Registers an arbitration decision before it updates crossbar ownership.
module Axi4QosArbiterRegister (
    clk      : input  clock_posedge     ,
    rst_n    : input  reset_async_low   ,
    request  : input  logic          <2>,
    qos      : input  logic          <8>,
    tie_break: input  logic          <4>,
    grant    : output logic          <2>,
) {
    var next_grant: logic<2>;

    inst arbiter: Axi4QosArbiter::<2> (
        request  : request   ,
        qos      : qos       ,
        tie_break: tie_break ,
        grant    : next_grant,
    );

    always_ff (clk, rst_n) {
        if_reset {
            grant = 2'b00;
        } else {
            if grant != 2'b00 {
                grant = 2'b00;
            } else {
                grant = next_grant;
            }
        }
    }
}

/// Four-input verification specialization for the parameterized arbiter.
module Axi4QosArbiter4 (
    request  : input  logic<4> ,
    qos      : input  logic<16>,
    tie_break: input  logic<16>,
    grant    : output logic<4> ,
) {
    inst arbiter: Axi4QosArbiter::<4> (
        request  : request  ,
        qos      : qos      ,
        tie_break: tie_break,
        grant    : grant    ,
    );
}

/// Fixed two-initiator, two-target AXI4 crossbar.
///
/// Each initiator may have two reads issued downstream and one more AR queued;
/// writes use two outstanding slots. Issued IDs differ. The downstream ID gains
/// an owner bit so responses can return out of order across IDs. Target 0 owns
/// 0x0000-0x3fff and target 1 owns 0x8000-0xbfff. Unmapped bursts complete
/// locally with DECERR.
module Axi4Crossbar2x2 (
    clk  : input   clock_posedge                        ,
    rst_n: input   reset_async_low                      ,
    s0   : modport Axi4Interface::<16, 32, 4>::target   ,
    s1   : modport Axi4Interface::<16, 32, 4>::target   ,
    m0   : modport Axi4Interface::<16, 32, 5>::initiator,
    m1   : modport Axi4Interface::<16, 32, 5>::initiator,
) {
    var s0_aw_full        : logic    ;
    var s0_aw_payload     : logic<49>;
    var s0_aw_decode_valid: logic    ;
    var s0_aw_decode_ready: logic    ;
    var s0_w_full         : logic    ;
    var s0_w_payload      : logic<37>;
    var s0_w_busy         : logic    ;
    var s0_w_error_active : logic    ;
    var s0_w_error_valid  : logic    ;
    var s0_w_error_id     : logic<4> ;
    var s0_w_slot0_valid  : logic    ;
    var s0_w_slot0_id     : logic<4> ;
    var s0_w_slot1_valid  : logic    ;
    var s0_w_slot1_id     : logic<4> ;
    var s0_w_release_match: logic<2> ;
    var s1_aw_full        : logic    ;
    var s1_aw_payload     : logic<49>;
    var s1_aw_decode_valid: logic    ;
    var s1_aw_decode_ready: logic    ;
    var s1_w_full         : logic    ;
    var s1_w_payload      : logic<37>;
    var s1_w_busy         : logic    ;
    var s1_w_error_active : logic    ;
    var s1_w_error_valid  : logic    ;
    var s1_w_error_id     : logic<4> ;
    var s1_w_slot0_valid  : logic    ;
    var s1_w_slot0_id     : logic<4> ;
    var s1_w_slot1_valid  : logic    ;
    var s1_w_slot1_id     : logic<4> ;
    var s1_w_release_match: logic<2> ;

    var wm0_active        : logic    ;
    var wm0_owner         : logic    ;
    var wm0_aw_sent       : logic    ;
    var wm0_w_done        : logic    ;
    var wm0_aw_payload    : logic<49>;
    var wm0_rr            : logic    ;
    var wm0_release       : logic    ;
    var wm0_release_owner : logic    ;
    var wm1_active        : logic    ;
    var wm1_owner         : logic    ;
    var wm1_aw_sent       : logic    ;
    var wm1_w_done        : logic    ;
    var wm1_aw_payload    : logic<49>;
    var wm1_rr            : logic    ;
    var wm1_release       : logic    ;
    var wm1_release_owner : logic    ;
    var s0_w_error_release: logic    ;
    var s1_w_error_release: logic    ;

    var s0_r_error_valid  : logic    ;
    var s0_r_error_ready  : logic    ;
    var s0_r_error_id     : logic<4> ;
    var s0_r_error_last   : logic    ;
    var s0_r_slot0_valid  : logic    ;
    var s0_r_slot0_id     : logic<4> ;
    var s0_r_slot1_valid  : logic    ;
    var s0_r_slot1_id     : logic<4> ;
    var s0_r_reserve      : logic    ;
    var s0_r_reserve_slot1: logic    ;
    var s0_r_reserve_id   : logic<4> ;
    var s0_r_release_match: logic<2> ;
    var s0_ar_full        : logic    ;
    var s0_ar_reserved    : logic    ;
    var s0_ar_payload     : logic<49>;
    var s0_ar_decode_valid: logic    ;
    var s0_ar_decode_ready: logic    ;
    var s1_r_error_valid  : logic    ;
    var s1_r_error_ready  : logic    ;
    var s1_r_error_id     : logic<4> ;
    var s1_r_error_last   : logic    ;
    var s1_r_slot0_valid  : logic    ;
    var s1_r_slot0_id     : logic<4> ;
    var s1_r_slot1_valid  : logic    ;
    var s1_r_slot1_id     : logic<4> ;
    var s1_r_reserve      : logic    ;
    var s1_r_reserve_slot1: logic    ;
    var s1_r_reserve_id   : logic<4> ;
    var s1_r_release_match: logic<2> ;
    var s1_ar_full        : logic    ;
    var s1_ar_reserved    : logic    ;
    var s1_ar_payload     : logic<49>;
    var s1_ar_decode_valid: logic    ;
    var s1_ar_decode_ready: logic    ;

    var rm0_active    : logic    ;
    var rm0_owner     : logic    ;
    var rm0_ar_payload: logic<49>;
    var rm0_rr        : logic    ;
    var rm1_active    : logic    ;
    var rm1_owner     : logic    ;
    var rm1_ar_payload: logic<49>;
    var rm1_rr        : logic    ;

    var wg00            : logic;
    var wg01            : logic;
    var wg10            : logic;
    var wg11            : logic;
    var wr00            : logic;
    var wr01            : logic;
    var wr10            : logic;
    var wr11            : logic;
    var w_dispatch0     : logic;
    var w_dispatch1     : logic;
    var w_error_grant0  : logic;
    var w_error_grant1  : logic;
    var w_pop0          : logic;
    var w_pop1          : logic;
    var w_error_consume0: logic;
    var w_error_consume1: logic;
    var wm0_aw_handshake: logic;
    var wm0_w_handshake : logic;
    var wm0_issue_done  : logic;
    var wm1_aw_handshake: logic;
    var wm1_w_handshake : logic;
    var wm1_issue_done  : logic;

    var s0_w_can_accept: logic;
    var s1_w_can_accept: logic;
    var s0_w_id_busy   : logic;
    var s1_w_id_busy   : logic;
    var s0_b_from_m0   : logic;
    var s0_b_from_m1   : logic;
    var s1_b_from_m0   : logic;
    var s1_b_from_m1   : logic;

    var rg00            : logic;
    var rg01            : logic;
    var rg10            : logic;
    var rg11            : logic;
    var rr00            : logic;
    var rr01            : logic;
    var rr10            : logic;
    var rr11            : logic;
    var r_accept0       : logic;
    var r_accept1       : logic;
    var r_error_accept0 : logic;
    var r_error_accept1 : logic;
    var rm0_ar_handshake: logic;
    var rm1_ar_handshake: logic;
    var s0_r_can_accept : logic;
    var s1_r_can_accept : logic;
    var s0_r_id_busy    : logic;
    var s1_r_id_busy    : logic;
    var s0_r_from_m0    : logic;
    var s0_r_from_m1    : logic;
    var s1_r_from_m0    : logic;
    var s1_r_from_m1    : logic;

    var s0_aw_target0     : logic;
    var s0_aw_target1     : logic;
    var s0_aw_decode_error: logic;
    var s1_aw_target0     : logic;
    var s1_aw_target1     : logic;
    var s1_aw_decode_error: logic;
    var s0_ar_target0     : logic;
    var s0_ar_target1     : logic;
    var s0_ar_decode_error: logic;
    var s1_ar_target0     : logic;
    var s1_ar_target1     : logic;
    var s1_ar_decode_error: logic;

    inst s0_aw_decoder: Axi4BurstDecoderPipeline (
        clk         : clk                 ,
        rst_n       : rst_n               ,
        in_valid    : s0_aw_full          ,
        in_ready    : s0_aw_decode_ready  ,
        addr        : s0_aw_payload[44:29],
        len         : s0_aw_payload[28:21],
        size        : s0_aw_payload[20:18],
        burst       : s0_aw_payload[17:16],
        out_valid   : s0_aw_decode_valid  ,
        out_ready   : w_dispatch0         ,
        target0     : s0_aw_target0       ,
        target1     : s0_aw_target1       ,
        decode_error: s0_aw_decode_error  ,
    );
    inst s1_aw_decoder: Axi4BurstDecoderPipeline (
        clk         : clk                 ,
        rst_n       : rst_n               ,
        in_valid    : s1_aw_full          ,
        in_ready    : s1_aw_decode_ready  ,
        addr        : s1_aw_payload[44:29],
        len         : s1_aw_payload[28:21],
        size        : s1_aw_payload[20:18],
        burst       : s1_aw_payload[17:16],
        out_valid   : s1_aw_decode_valid  ,
        out_ready   : w_dispatch1         ,
        target0     : s1_aw_target0       ,
        target1     : s1_aw_target1       ,
        decode_error: s1_aw_decode_error  ,
    );
    inst s0_ar_decoder: Axi4BurstDecoderPipeline (
        clk         : clk                         ,
        rst_n       : rst_n                       ,
        in_valid    : s0_ar_full && s0_ar_reserved,
        in_ready    : s0_ar_decode_ready          ,
        addr        : s0_ar_payload[44:29]        ,
        len         : s0_ar_payload[28:21]        ,
        size        : s0_ar_payload[20:18]        ,
        burst       : s0_ar_payload[17:16]        ,
        out_valid   : s0_ar_decode_valid          ,
        out_ready   : r_accept0                   ,
        target0     : s0_ar_target0               ,
        target1     : s0_ar_target1               ,
        decode_error: s0_ar_decode_error          ,
    );
    inst s1_ar_decoder: Axi4BurstDecoderPipeline (
        clk         : clk                         ,
        rst_n       : rst_n                       ,
        in_valid    : s1_ar_full && s1_ar_reserved,
        in_ready    : s1_ar_decode_ready          ,
        addr        : s1_ar_payload[44:29]        ,
        len         : s1_ar_payload[28:21]        ,
        size        : s1_ar_payload[20:18]        ,
        burst       : s1_ar_payload[17:16]        ,
        out_valid   : s1_ar_decode_valid          ,
        out_ready   : r_accept1                   ,
        target0     : s1_ar_target0               ,
        target1     : s1_ar_target1               ,
        decode_error: s1_ar_decode_error          ,
    );
    inst s0_r_error_responder: Axi4ReadDecodeErrorResponder (
        clk           : clk                 ,
        rst_n         : rst_n               ,
        start_valid   : r_error_accept0     ,
        start_ready   : s0_r_error_ready    ,
        start_id      : s0_ar_payload[48:45],
        start_len     : s0_ar_payload[28:21],
        response_valid: s0_r_error_valid    ,
        response_ready: s0.rready           ,
        response_id   : s0_r_error_id       ,
        response_last : s0_r_error_last     ,
    );
    inst s1_r_error_responder: Axi4ReadDecodeErrorResponder (
        clk           : clk                 ,
        rst_n         : rst_n               ,
        start_valid   : r_error_accept1     ,
        start_ready   : s1_r_error_ready    ,
        start_id      : s1_ar_payload[48:45],
        start_len     : s1_ar_payload[28:21],
        response_valid: s1_r_error_valid    ,
        response_ready: s1.rready           ,
        response_id   : s1_r_error_id       ,
        response_last : s1_r_error_last     ,
    );
    inst s0_w_releaser: Axi4IdReleasePipeline (
        clk          : clk                   ,
        rst_n        : rst_n                 ,
        release_valid: s0.bvalid && s0.bready,
        release_id   : s0.bid                ,
        slot0_valid  : s0_w_slot0_valid      ,
        slot0_id     : s0_w_slot0_id         ,
        slot1_valid  : s0_w_slot1_valid      ,
        slot1_id     : s0_w_slot1_id         ,
        match        : s0_w_release_match    ,
    );
    inst s1_w_releaser: Axi4IdReleasePipeline (
        clk          : clk                   ,
        rst_n        : rst_n                 ,
        release_valid: s1.bvalid && s1.bready,
        release_id   : s1.bid                ,
        slot0_valid  : s1_w_slot0_valid      ,
        slot0_id     : s1_w_slot0_id         ,
        slot1_valid  : s1_w_slot1_valid      ,
        slot1_id     : s1_w_slot1_id         ,
        match        : s1_w_release_match    ,
    );
    inst s0_r_releaser: Axi4IdReleasePipeline (
        clk          : clk                               ,
        rst_n        : rst_n                             ,
        release_valid: s0.rvalid && s0.rready && s0.rlast,
        release_id   : s0.rid                            ,
        slot0_valid  : s0_r_slot0_valid                  ,
        slot0_id     : s0_r_slot0_id                     ,
        slot1_valid  : s0_r_slot1_valid                  ,
        slot1_id     : s0_r_slot1_id                     ,
        match        : s0_r_release_match                ,
    );
    inst s1_r_releaser: Axi4IdReleasePipeline (
        clk          : clk                               ,
        rst_n        : rst_n                             ,
        release_valid: s1.rvalid && s1.rready && s1.rlast,
        release_id   : s1.rid                            ,
        slot0_valid  : s1_r_slot0_valid                  ,
        slot0_id     : s1_r_slot0_id                     ,
        slot1_valid  : s1_r_slot1_valid                  ,
        slot1_id     : s1_r_slot1_id                     ,
        match        : s1_r_release_match                ,
    );

    // Completion can depend on the final W beat and several ownership bits.
    // Register one-cycle release pulses before feeding that cone back into
    // the initiator busy state.
    always_ff (clk, rst_n) {
        if_reset {
            wm0_release        = 1'b0;
            wm0_release_owner  = 1'b0;
            wm1_release        = 1'b0;
            wm1_release_owner  = 1'b0;
            s0_w_error_release = 1'b0;
            s1_w_error_release = 1'b0;
        } else {
            wm0_release = wm0_issue_done;
            if wm0_issue_done {
                wm0_release_owner = wm0_owner;
            }
            wm1_release = wm1_issue_done;
            if wm1_issue_done {
                wm1_release_owner = wm1_owner;
            }
            s0_w_error_release = w_error_consume0 && s0_w_payload[0];
            s1_w_error_release = w_error_consume1 && s1_w_payload[0];
        }
    }

    // Capture read-slot allocation as a one-cycle event. The address skid
    // register blocks another AR immediately, while this register boundary
    // removes the outstanding-ID comparison from the slot state feedback.
    // Synthesis may update the qualified payload bits unconditionally because
    // they are only observed while the reserve pulse is high.
    always_ff (clk, rst_n) {
        if_reset {
            s0_r_reserve       = 1'b0;
            s0_r_reserve_slot1 = 1'b0;
            s0_r_reserve_id    = 4'b0;
            s1_r_reserve       = 1'b0;
            s1_r_reserve_slot1 = 1'b0;
            s1_r_reserve_id    = 4'b0;
        } else {
            s0_r_reserve = s0_ar_full && !s0_ar_reserved && s0_r_can_accept;
            if s0_ar_full && !s0_ar_reserved && s0_r_can_accept {
                s0_r_reserve_slot1 = s0_r_slot0_valid;
                s0_r_reserve_id    = s0_ar_payload[48:45];
            }
            s1_r_reserve = s1_ar_full && !s1_ar_reserved && s1_r_can_accept;
            if s1_ar_full && !s1_ar_reserved && s1_r_can_accept {
                s1_r_reserve_slot1 = s1_r_slot0_valid;
                s1_r_reserve_id    = s1_ar_payload[48:45];
            }
        }
    }

    inst wm0_arbiter: Axi4QosArbiterRegister (
        clk      : clk                                       ,
        rst_n    : rst_n                                     ,
        request  : {!wm0_active && wr01, !wm0_active && wr00},
        qos      : {s1_aw_payload[7:4], s0_aw_payload[7:4]},
        tie_break: if wm0_rr ? 4'b0100 : 4'b0010,
        grant    : {wg01, wg00},
    );
    inst wm1_arbiter: Axi4QosArbiterRegister (
        clk      : clk                                       ,
        rst_n    : rst_n                                     ,
        request  : {!wm1_active && wr11, !wm1_active && wr10},
        qos      : {s1_aw_payload[7:4], s0_aw_payload[7:4]},
        tie_break: if wm1_rr ? 4'b0100 : 4'b0010,
        grant    : {wg11, wg10},
    );
    inst rm0_arbiter: Axi4QosArbiterRegister (
        clk      : clk                                       ,
        rst_n    : rst_n                                     ,
        request  : {!rm0_active && rr01, !rm0_active && rr00},
        qos      : {s1_ar_payload[7:4], s0_ar_payload[7:4]},
        tie_break: if rm0_rr ? 4'b0100 : 4'b0010,
        grant    : {rg01, rg00},
    );
    inst rm1_arbiter: Axi4QosArbiterRegister (
        clk      : clk                                       ,
        rst_n    : rst_n                                     ,
        request  : {!rm1_active && rr11, !rm1_active && rr10},
        qos      : {s1_ar_payload[7:4], s0_ar_payload[7:4]},
        tie_break: if rm1_rr ? 4'b0100 : 4'b0010,
        grant    : {rg11, rg10},
    );

    always_comb {
        // Write address admission reserves one of two per-initiator ID slots.
        s0_w_id_busy    = (s0_w_slot0_valid && (s0_w_slot0_id == s0.awid))
            || (s0_w_slot1_valid && (s0_w_slot1_id == s0.awid));
        s1_w_id_busy    = (s1_w_slot0_valid && (s1_w_slot0_id == s1.awid))
            || (s1_w_slot1_valid && (s1_w_slot1_id == s1.awid));
        s0_w_can_accept = (!s0_w_slot0_valid || !s0_w_slot1_valid) && !s0_w_id_busy;
        s1_w_can_accept = (!s1_w_slot0_valid || !s1_w_slot1_valid) && !s1_w_id_busy;
        s0.awready      = !s0_aw_full && s0_w_can_accept;
        s1.awready      = !s1_aw_full && s1_w_can_accept;

        // A target owns a W stream only through the final W beat. B responses
        // are routed independently by the owner bit added to the downstream ID.
        wr00           = s0_aw_full && s0_aw_decode_valid && s0_w_full && !s0_w_busy && s0_aw_target0;
        wr01           = s1_aw_full && s1_aw_decode_valid && s1_w_full && !s1_w_busy && s1_aw_target0;
        wr10           = s0_aw_full && s0_aw_decode_valid && s0_w_full && !s0_w_busy && s0_aw_target1;
        wr11           = s1_aw_full && s1_aw_decode_valid && s1_w_full && !s1_w_busy && s1_aw_target1;
        w_error_grant0 = s0_aw_full && s0_w_full && !s0_w_busy && !s0_w_error_active && !s0_w_error_valid
            && s0_aw_decode_valid && s0_aw_decode_error;
        w_error_grant1 = s1_aw_full && s1_w_full && !s1_w_busy && !s1_w_error_active && !s1_w_error_valid
            && s1_aw_decode_valid && s1_aw_decode_error;
        w_dispatch0    = wg00 || wg10 || w_error_grant0;
        w_dispatch1    = wg01 || wg11 || w_error_grant1;

        m0.awid          = {wm0_owner, wm0_aw_payload[48:45]};
        m0.awaddr        = wm0_aw_payload[44:29];
        m0.awlen         = wm0_aw_payload[28:21];
        m0.awsize        = wm0_aw_payload[20:18];
        m0.awburst       = wm0_aw_payload[17:16];
        m0.awlock        = wm0_aw_payload[15];
        m0.awcache       = wm0_aw_payload[14:11];
        m0.awprot        = wm0_aw_payload[10:8];
        m0.awqos         = wm0_aw_payload[7:4];
        m0.awregion      = wm0_aw_payload[3:0];
        m0.awvalid       = wm0_active && !wm0_aw_sent;
        m0.wdata         = if wm0_owner ? s1_w_payload[36:5] : s0_w_payload[36:5];
        m0.wstrb         = if wm0_owner ? s1_w_payload[4:1] : s0_w_payload[4:1];
        m0.wlast         = if wm0_owner ? s1_w_payload[0] : s0_w_payload[0];
        m0.wvalid        = wm0_active && !wm0_w_done && (if wm0_owner ? s1_w_full : s0_w_full);
        wm0_aw_handshake = m0.awvalid && m0.awready;
        wm0_w_handshake  = m0.wvalid && m0.wready;
        wm0_issue_done   = wm0_active && (wm0_aw_sent || wm0_aw_handshake)
            && (wm0_w_done || (wm0_w_handshake && m0.wlast));

        m1.awid          = {wm1_owner, wm1_aw_payload[48:45]};
        m1.awaddr        = wm1_aw_payload[44:29];
        m1.awlen         = wm1_aw_payload[28:21];
        m1.awsize        = wm1_aw_payload[20:18];
        m1.awburst       = wm1_aw_payload[17:16];
        m1.awlock        = wm1_aw_payload[15];
        m1.awcache       = wm1_aw_payload[14:11];
        m1.awprot        = wm1_aw_payload[10:8];
        m1.awqos         = wm1_aw_payload[7:4];
        m1.awregion      = wm1_aw_payload[3:0];
        m1.awvalid       = wm1_active && !wm1_aw_sent;
        m1.wdata         = if wm1_owner ? s1_w_payload[36:5] : s0_w_payload[36:5];
        m1.wstrb         = if wm1_owner ? s1_w_payload[4:1] : s0_w_payload[4:1];
        m1.wlast         = if wm1_owner ? s1_w_payload[0] : s0_w_payload[0];
        m1.wvalid        = wm1_active && !wm1_w_done && (if wm1_owner ? s1_w_full : s0_w_full);
        wm1_aw_handshake = m1.awvalid && m1.awready;
        wm1_w_handshake  = m1.wvalid && m1.wready;
        wm1_issue_done   = wm1_active && (wm1_aw_sent || wm1_aw_handshake)
            && (wm1_w_done || (wm1_w_handshake && m1.wlast));

        w_error_consume0 = s0_w_error_active && s0_w_full;
        w_error_consume1 = s1_w_error_active && s1_w_full;
        w_pop0           = w_error_consume0 || (wm0_w_handshake && !wm0_owner) || (wm1_w_handshake && !wm1_owner);
        w_pop1           = w_error_consume1 || (wm0_w_handshake && wm0_owner) || (wm1_w_handshake && wm1_owner);
        s0.wready        = !s0_w_full || w_pop0;
        s1.wready        = !s1_w_full || w_pop1;

        s0_b_from_m0 = m0.bvalid && !m0.bid[4];
        s0_b_from_m1 = m1.bvalid && !m1.bid[4];
        s1_b_from_m0 = m0.bvalid && m0.bid[4];
        s1_b_from_m1 = m1.bvalid && m1.bid[4];
        s0.bvalid    = s0_w_error_valid || s0_b_from_m0 || s0_b_from_m1;
        s0.bid       = if s0_w_error_valid ? s0_w_error_id : if s0_b_from_m0 ? m0.bid[3:0] : m1.bid[3:0];
        s0.bresp     = if s0_w_error_valid ? 2'b11 : if s0_b_from_m0 ? m0.bresp : m1.bresp;
        s1.bvalid    = s1_w_error_valid || s1_b_from_m0 || s1_b_from_m1;
        s1.bid       = if s1_w_error_valid ? s1_w_error_id : if s1_b_from_m0 ? m0.bid[3:0] : m1.bid[3:0];
        s1.bresp     = if s1_w_error_valid ? 2'b11 : if s1_b_from_m0 ? m0.bresp : m1.bresp;
        m0.bready    = m0.bvalid
            && (if m0.bid[4] ? (!s1_w_error_valid && s1.bready) : (!s0_w_error_valid && s0.bready));
        m1.bready    = m1.bvalid
            && (if m1.bid[4] ?
                (!s1_w_error_valid && !s1_b_from_m0 && s1.bready)
            :
                (!s0_w_error_valid && !s0_b_from_m0 && s0.bready)
            );

        // Read address admission also reserves two unique-ID slots. The target
        // address skid registers are released after AR, not after the R burst.
        s0_r_id_busy    = (s0_r_slot0_valid && (s0_r_slot0_id == s0_ar_payload[48:45]))
            || (s0_r_slot1_valid && (s0_r_slot1_id == s0_ar_payload[48:45]));
        s1_r_id_busy    = (s1_r_slot0_valid && (s1_r_slot0_id == s1_ar_payload[48:45]))
            || (s1_r_slot1_valid && (s1_r_slot1_id == s1_ar_payload[48:45]));
        s0_r_can_accept = (!s0_r_slot0_valid || !s0_r_slot1_valid) && !s0_r_id_busy;
        s1_r_can_accept = (!s1_r_slot0_valid || !s1_r_slot1_valid) && !s1_r_id_busy;
        s0.arready      = !s0_ar_full;
        s1.arready      = !s1_ar_full;
        rr00            = s0_ar_full && s0_ar_decode_valid && s0_ar_target0;
        rr01            = s1_ar_full && s1_ar_decode_valid && s1_ar_target0;
        rr10            = s0_ar_full && s0_ar_decode_valid && s0_ar_target1;
        rr11            = s1_ar_full && s1_ar_decode_valid && s1_ar_target1;
        r_error_accept0 = s0_ar_full && s0_ar_decode_valid && s0_r_error_ready && s0_ar_decode_error;
        r_error_accept1 = s1_ar_full && s1_ar_decode_valid && s1_r_error_ready && s1_ar_decode_error;
        r_accept0       = rg00 || rg10 || r_error_accept0;
        r_accept1       = rg01 || rg11 || r_error_accept1;

        m0.arid          = {rm0_owner, rm0_ar_payload[48:45]};
        m0.araddr        = rm0_ar_payload[44:29];
        m0.arlen         = rm0_ar_payload[28:21];
        m0.arsize        = rm0_ar_payload[20:18];
        m0.arburst       = rm0_ar_payload[17:16];
        m0.arlock        = rm0_ar_payload[15];
        m0.arcache       = rm0_ar_payload[14:11];
        m0.arprot        = rm0_ar_payload[10:8];
        m0.arqos         = rm0_ar_payload[7:4];
        m0.arregion      = rm0_ar_payload[3:0];
        m0.arvalid       = rm0_active;
        rm0_ar_handshake = m0.arvalid && m0.arready;

        m1.arid          = {rm1_owner, rm1_ar_payload[48:45]};
        m1.araddr        = rm1_ar_payload[44:29];
        m1.arlen         = rm1_ar_payload[28:21];
        m1.arsize        = rm1_ar_payload[20:18];
        m1.arburst       = rm1_ar_payload[17:16];
        m1.arlock        = rm1_ar_payload[15];
        m1.arcache       = rm1_ar_payload[14:11];
        m1.arprot        = rm1_ar_payload[10:8];
        m1.arqos         = rm1_ar_payload[7:4];
        m1.arregion      = rm1_ar_payload[3:0];
        m1.arvalid       = rm1_active;
        rm1_ar_handshake = m1.arvalid && m1.arready;

        s0_r_from_m0 = m0.rvalid && !m0.rid[4];
        s0_r_from_m1 = m1.rvalid && !m1.rid[4];
        s1_r_from_m0 = m0.rvalid && m0.rid[4];
        s1_r_from_m1 = m1.rvalid && m1.rid[4];
        s0.rvalid    = s0_r_error_valid || s0_r_from_m0 || s0_r_from_m1;
        s0.rid       = if s0_r_error_valid ? s0_r_error_id : if s0_r_from_m0 ? m0.rid[3:0] : m1.rid[3:0];
        s0.rdata     = if s0_r_error_valid ? 32'h00000000 : if s0_r_from_m0 ? m0.rdata : m1.rdata;
        s0.rresp     = if s0_r_error_valid ? 2'b11 : if s0_r_from_m0 ? m0.rresp : m1.rresp;
        s0.rlast     = if s0_r_error_valid ? s0_r_error_last : if s0_r_from_m0 ? m0.rlast : m1.rlast;
        s1.rvalid    = s1_r_error_valid || s1_r_from_m0 || s1_r_from_m1;
        s1.rid       = if s1_r_error_valid ? s1_r_error_id : if s1_r_from_m0 ? m0.rid[3:0] : m1.rid[3:0];
        s1.rdata     = if s1_r_error_valid ? 32'h00000000 : if s1_r_from_m0 ? m0.rdata : m1.rdata;
        s1.rresp     = if s1_r_error_valid ? 2'b11 : if s1_r_from_m0 ? m0.rresp : m1.rresp;
        s1.rlast     = if s1_r_error_valid ? s1_r_error_last : if s1_r_from_m0 ? m0.rlast : m1.rlast;
        m0.rready    = m0.rvalid
            && (if m0.rid[4] ? (!s1_r_error_valid && s1.rready) : (!s0_r_error_valid && s0.rready));
        m1.rready    = m1.rvalid
            && (if m1.rid[4] ?
                (!s1_r_error_valid && !s1_r_from_m0 && s1.rready)
            :
                (!s0_r_error_valid && !s0_r_from_m0 && s0.rready)
            );
    }

    always_ff (clk, rst_n) {
        if_reset {
            s0_aw_full        = 1'b0;
            s0_aw_payload     = 49'b0;
            s0_w_full         = 1'b0;
            s0_w_payload      = 37'b0;
            s0_w_busy         = 1'b0;
            s0_w_error_active = 1'b0;
            s0_w_error_valid  = 1'b0;
            s0_w_error_id     = 4'b0;
            s0_w_slot0_valid  = 1'b0;
            s0_w_slot0_id     = 4'b0;
            s0_w_slot1_valid  = 1'b0;
            s0_w_slot1_id     = 4'b0;
            s1_aw_full        = 1'b0;
            s1_aw_payload     = 49'b0;
            s1_w_full         = 1'b0;
            s1_w_payload      = 37'b0;
            s1_w_busy         = 1'b0;
            s1_w_error_active = 1'b0;
            s1_w_error_valid  = 1'b0;
            s1_w_error_id     = 4'b0;
            s1_w_slot0_valid  = 1'b0;
            s1_w_slot0_id     = 4'b0;
            s1_w_slot1_valid  = 1'b0;
            s1_w_slot1_id     = 4'b0;
            wm0_active        = 1'b0;
            wm0_owner         = 1'b0;
            wm0_aw_sent       = 1'b0;
            wm0_w_done        = 1'b0;
            wm0_aw_payload    = 49'b0;
            wm0_rr            = 1'b0;
            wm1_active        = 1'b0;
            wm1_owner         = 1'b0;
            wm1_aw_sent       = 1'b0;
            wm1_w_done        = 1'b0;
            wm1_aw_payload    = 49'b0;
            wm1_rr            = 1'b0;
            s0_r_slot0_valid  = 1'b0;
            s0_r_slot0_id     = 4'b0;
            s0_r_slot1_valid  = 1'b0;
            s0_r_slot1_id     = 4'b0;
            s0_ar_full        = 1'b0;
            s0_ar_reserved    = 1'b0;
            s0_ar_payload     = 49'b0;
            s1_r_slot0_valid  = 1'b0;
            s1_r_slot0_id     = 4'b0;
            s1_r_slot1_valid  = 1'b0;
            s1_r_slot1_id     = 4'b0;
            s1_ar_full        = 1'b0;
            s1_ar_reserved    = 1'b0;
            s1_ar_payload     = 49'b0;
        } else {
            if s0.awvalid && s0.awready {
                s0_aw_full    = 1'b1;
                s0_aw_payload = {
                    s0.awid, s0.awaddr, s0.awlen, s0.awsize, s0.awburst, s0.awlock, s0.awcache, s0.awprot, s0.awqos,
                    s0.awregion
                };
                if !s0_w_slot0_valid {
                    s0_w_slot0_valid = 1'b1;
                    s0_w_slot0_id    = s0.awid;
                } else {
                    s0_w_slot1_valid = 1'b1;
                    s0_w_slot1_id    = s0.awid;
                }
            }
            if s1.awvalid && s1.awready {
                s1_aw_full    = 1'b1;
                s1_aw_payload = {
                    s1.awid, s1.awaddr, s1.awlen, s1.awsize, s1.awburst, s1.awlock, s1.awcache, s1.awprot, s1.awqos,
                    s1.awregion
                };
                if !s1_w_slot0_valid {
                    s1_w_slot0_valid = 1'b1;
                    s1_w_slot0_id    = s1.awid;
                } else {
                    s1_w_slot1_valid = 1'b1;
                    s1_w_slot1_id    = s1.awid;
                }
            }
            if w_pop0 {
                s0_w_full = 1'b0;
            }
            if s0.wvalid && s0.wready {
                s0_w_full    = 1'b1;
                s0_w_payload = {s0.wdata, s0.wstrb, s0.wlast};
            }
            if w_pop1 {
                s1_w_full = 1'b0;
            }
            if s1.wvalid && s1.wready {
                s1_w_full    = 1'b1;
                s1_w_payload = {s1.wdata, s1.wstrb, s1.wlast};
            }

            if w_dispatch0 {
                s0_aw_full = 1'b0;
                s0_w_busy  = 1'b1;
            }
            if w_dispatch1 {
                s1_aw_full = 1'b0;
                s1_w_busy  = 1'b1;
            }
            if s0_w_release_match[0] {
                s0_w_slot0_valid = 1'b0;
            }
            if s0_w_release_match[1] {
                s0_w_slot1_valid = 1'b0;
            }
            if s0.bvalid && s0.bready {
                s0_w_error_valid = 1'b0;
            }
            if s1_w_release_match[0] {
                s1_w_slot0_valid = 1'b0;
            }
            if s1_w_release_match[1] {
                s1_w_slot1_valid = 1'b0;
            }
            if s1.bvalid && s1.bready {
                s1_w_error_valid = 1'b0;
            }
            if w_error_grant0 {
                s0_w_error_active = 1'b1;
                s0_w_error_id     = s0_aw_payload[48:45];
            }
            if w_error_consume0 && s0_w_payload[0] {
                s0_w_error_active = 1'b0;
                s0_w_error_valid  = 1'b1;
            }
            if w_error_grant1 {
                s1_w_error_active = 1'b1;
                s1_w_error_id     = s1_aw_payload[48:45];
            }
            if w_error_consume1 && s1_w_payload[0] {
                s1_w_error_active = 1'b0;
                s1_w_error_valid  = 1'b1;
            }

            if wg00 || wg01 {
                wm0_active     = 1'b1;
                wm0_owner      = wg01;
                wm0_aw_sent    = 1'b0;
                wm0_w_done     = 1'b0;
                wm0_aw_payload = if wg01 ? s1_aw_payload : s0_aw_payload;
            }
            if wm0_aw_handshake {
                wm0_aw_sent = 1'b1;
            }
            if wm0_w_handshake && m0.wlast {
                wm0_w_done = 1'b1;
            }
            if wm0_issue_done {
                wm0_active = 1'b0;
                wm0_rr     = !wm0_owner;
            }
            if wg10 || wg11 {
                wm1_active     = 1'b1;
                wm1_owner      = wg11;
                wm1_aw_sent    = 1'b0;
                wm1_w_done     = 1'b0;
                wm1_aw_payload = if wg11 ? s1_aw_payload : s0_aw_payload;
            }
            if wm1_aw_handshake {
                wm1_aw_sent = 1'b1;
            }
            if wm1_w_handshake && m1.wlast {
                wm1_w_done = 1'b1;
            }
            if wm1_issue_done {
                wm1_active = 1'b0;
                wm1_rr     = !wm1_owner;
            }
            if s0_w_error_release || (wm0_release && !wm0_release_owner) || (wm1_release && !wm1_release_owner) {
                s0_w_busy = 1'b0;
            }
            if s1_w_error_release || (wm0_release && wm0_release_owner) || (wm1_release && wm1_release_owner) {
                s1_w_busy = 1'b0;
            }

            if s0.arvalid && s0.arready {
                s0_ar_full    = 1'b1;
                s0_ar_payload = {
                    s0.arid, s0.araddr, s0.arlen, s0.arsize, s0.arburst, s0.arlock, s0.arcache, s0.arprot, s0.arqos,
                    s0.arregion
                };
            }
            if s1.arvalid && s1.arready {
                s1_ar_full    = 1'b1;
                s1_ar_payload = {
                    s1.arid, s1.araddr, s1.arlen, s1.arsize, s1.arburst, s1.arlock, s1.arcache, s1.arprot, s1.arqos,
                    s1.arregion
                };
            }
            if r_accept0 {
                s0_ar_full     = 1'b0;
                s0_ar_reserved = 1'b0;
            }
            if r_accept1 {
                s1_ar_full     = 1'b0;
                s1_ar_reserved = 1'b0;
            }
            if s0_r_release_match[0] {
                s0_r_slot0_valid = 1'b0;
            }
            if s0_r_release_match[1] {
                s0_r_slot1_valid = 1'b0;
            }
            if s1_r_release_match[0] {
                s1_r_slot0_valid = 1'b0;
            }
            if s1_r_release_match[1] {
                s1_r_slot1_valid = 1'b0;
            }
            if s0_r_reserve {
                s0_ar_reserved = 1'b1;
                if s0_r_reserve_slot1 {
                    s0_r_slot1_valid = 1'b1;
                    s0_r_slot1_id    = s0_r_reserve_id;
                } else {
                    s0_r_slot0_valid = 1'b1;
                    s0_r_slot0_id    = s0_r_reserve_id;
                }
            }
            if s1_r_reserve {
                s1_ar_reserved = 1'b1;
                if s1_r_reserve_slot1 {
                    s1_r_slot1_valid = 1'b1;
                    s1_r_slot1_id    = s1_r_reserve_id;
                } else {
                    s1_r_slot0_valid = 1'b1;
                    s1_r_slot0_id    = s1_r_reserve_id;
                }
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            rm0_active     = 1'b0;
            rm0_owner      = 1'b0;
            rm0_ar_payload = 49'b0;
            rm0_rr         = 1'b0;
            rm1_active     = 1'b0;
            rm1_owner      = 1'b0;
            rm1_ar_payload = 49'b0;
            rm1_rr         = 1'b0;
        } else {
            if rg00 || rg01 {
                rm0_active     = 1'b1;
                rm0_owner      = rg01;
                rm0_ar_payload = if rg01 ? s1_ar_payload : s0_ar_payload;
            }
            if rm0_ar_handshake {
                rm0_active = 1'b0;
                rm0_rr     = !rm0_owner;
            }
            if rg10 || rg11 {
                rm1_active     = 1'b1;
                rm1_owner      = rg11;
                rm1_ar_payload = if rg11 ? s1_ar_payload : s0_ar_payload;
            }
            if rm1_ar_handshake {
                rm1_active = 1'b0;
                rm1_rr     = !rm1_owner;
            }
        }
    }
}

/// Closed-system synthesis top that verifies one routed AXI4 read transaction.
module Axi4CrossbarSelfTest (
    clk   : input  clock_posedge  ,
    rst_n : input  reset_async_low,
    passed: output logic          ,
    failed: output logic          ,
) {
    inst s0      : Axi4Interface::<16, 32, 4>;
    inst s1      : Axi4Interface::<16, 32, 4>;
    inst m0      : Axi4Interface::<16, 32, 5>;
    inst m1      : Axi4Interface::<16, 32, 5>;
    inst crossbar: Axi4Crossbar2x2 (
        clk  : clk  ,
        rst_n: rst_n,
        s0   : s0   ,
        s1   : s1   ,
        m0   : m0   ,
        m1   : m1   ,
    );

    var request_active: logic   ;
    var response_valid: logic   ;
    var response_id   : logic<5>;
    var check_valid   : logic   ;
    var check_ok      : logic   ;

    always_comb {
        s0.awid     = 4'h0;
        s0.awaddr   = 16'h0000;
        s0.awlen    = 8'h00;
        s0.awsize   = 3'h2;
        s0.awburst  = 2'h1;
        s0.awlock   = 1'b0;
        s0.awcache  = 4'h0;
        s0.awprot   = 3'h0;
        s0.awqos    = 4'h0;
        s0.awregion = 4'h0;
        s0.awvalid  = 1'b0;
        s0.wdata    = 32'h00000000;
        s0.wstrb    = 4'h0;
        s0.wlast    = 1'b0;
        s0.wvalid   = 1'b0;
        s0.bready   = 1'b1;
        s0.arid     = 4'h3;
        s0.araddr   = 16'h0120;
        s0.arlen    = 8'h00;
        s0.arsize   = 3'h2;
        s0.arburst  = 2'h1;
        s0.arlock   = 1'b0;
        s0.arcache  = 4'h0;
        s0.arprot   = 3'h0;
        s0.arqos    = 4'h0;
        s0.arregion = 4'h0;
        s0.arvalid  = request_active;
        s0.rready   = 1'b1;

        s1.awid     = 4'h0;
        s1.awaddr   = 16'h0000;
        s1.awlen    = 8'h00;
        s1.awsize   = 3'h2;
        s1.awburst  = 2'h1;
        s1.awlock   = 1'b0;
        s1.awcache  = 4'h0;
        s1.awprot   = 3'h0;
        s1.awqos    = 4'h0;
        s1.awregion = 4'h0;
        s1.awvalid  = 1'b0;
        s1.wdata    = 32'h00000000;
        s1.wstrb    = 4'h0;
        s1.wlast    = 1'b0;
        s1.wvalid   = 1'b0;
        s1.bready   = 1'b1;
        s1.arid     = 4'h0;
        s1.araddr   = 16'h0000;
        s1.arlen    = 8'h00;
        s1.arsize   = 3'h2;
        s1.arburst  = 2'h1;
        s1.arlock   = 1'b0;
        s1.arcache  = 4'h0;
        s1.arprot   = 3'h0;
        s1.arqos    = 4'h0;
        s1.arregion = 4'h0;
        s1.arvalid  = 1'b0;
        s1.rready   = 1'b1;

        m0.awready = 1'b1;
        m0.wready  = 1'b1;
        m0.bid     = 5'h00;
        m0.bresp   = 2'b00;
        m0.bvalid  = 1'b0;
        m0.arready = 1'b1;
        m0.rid     = response_id;
        m0.rdata   = 32'h5a5ac33c;
        m0.rresp   = 2'b00;
        m0.rlast   = 1'b1;
        m0.rvalid  = response_valid;

        m1.awready = 1'b1;
        m1.wready  = 1'b1;
        m1.bid     = 5'h00;
        m1.bresp   = 2'b00;
        m1.bvalid  = 1'b0;
        m1.arready = 1'b1;
        m1.rid     = 5'h00;
        m1.rdata   = 32'h00000000;
        m1.rresp   = 2'b00;
        m1.rlast   = 1'b0;
        m1.rvalid  = 1'b0;
    }

    // Keep the crossbar response cone out of the sticky result registers.
    // A separate sequential block is required so the checker consumes the
    // previous cycle's registered result rather than the same next-state
    // expression.
    always_ff (clk, rst_n) {
        if_reset {
            check_valid = 1'b0;
            check_ok    = 1'b0;
        } else {
            check_valid = s0.rvalid && s0.rready;
            if s0.rvalid && s0.rready {
                check_ok = (s0.rid == 4'h3) && (s0.rdata == 32'h5a5ac33c) && (s0.rresp == 2'b00) && s0.rlast;
            }
        }
    }

    always_ff (clk, rst_n) {
        if_reset {
            request_active = 1'b1;
            response_valid = 1'b0;
            response_id    = 5'h00;
            passed         = 1'b0;
            failed         = 1'b0;
        } else {
            if s0.arvalid && s0.arready {
                request_active = 1'b0;
            }
            if m0.arvalid && m0.arready {
                response_valid = 1'b1;
                response_id    = m0.arid;
            }
            if m0.rvalid && m0.rready {
                response_valid = 1'b0;
            }
            if check_valid {
                if check_ok {
                    passed = 1'b1;
                } else {
                    failed = 1'b1;
                }
            }
        }
    }
}
