/// AXI4 channels shared by initiators, targets, and verification wrappers.
interface Axi4Interface::<ADDR_WIDTH: u32 = 16, DATA_WIDTH: u32 = 32, ID_WIDTH: u32 = 4> {
    var awid    : logic<ID_WIDTH>      ;
    var awaddr  : logic<ADDR_WIDTH>    ;
    var awlen   : logic<8>             ;
    var awsize  : logic<3>             ;
    var awburst : logic<2>             ;
    var awlock  : logic                ;
    var awcache : logic<4>             ;
    var awprot  : logic<3>             ;
    var awqos   : logic<4>             ;
    var awregion: logic<4>             ;
    var awvalid : logic                ;
    var awready : logic                ;
    var wdata   : logic<DATA_WIDTH>    ;
    var wstrb   : logic<DATA_WIDTH / 8>;
    var wlast   : logic                ;
    var wvalid  : logic                ;
    var wready  : logic                ;
    var bid     : logic<ID_WIDTH>      ;
    var bresp   : logic<2>             ;
    var bvalid  : logic                ;
    var bready  : logic                ;
    var arid    : logic<ID_WIDTH>      ;
    var araddr  : logic<ADDR_WIDTH>    ;
    var arlen   : logic<8>             ;
    var arsize  : logic<3>             ;
    var arburst : logic<2>             ;
    var arlock  : logic                ;
    var arcache : logic<4>             ;
    var arprot  : logic<3>             ;
    var arqos   : logic<4>             ;
    var arregion: logic<4>             ;
    var arvalid : logic                ;
    var arready : logic                ;
    var rid     : logic<ID_WIDTH>      ;
    var rdata   : logic<DATA_WIDTH>    ;
    var rresp   : logic<2>             ;
    var rlast   : logic                ;
    var rvalid  : logic                ;
    var rready  : logic                ;

    modport initiator {
        awid    : output,
        awaddr  : output,
        awlen   : output,
        awsize  : output,
        awburst : output,
        awlock  : output,
        awcache : output,
        awprot  : output,
        awqos   : output,
        awregion: output,
        awvalid : output,
        awready : input ,
        wdata   : output,
        wstrb   : output,
        wlast   : output,
        wvalid  : output,
        wready  : input ,
        bid     : input ,
        bresp   : input ,
        bvalid  : input ,
        bready  : output,
        arid    : output,
        araddr  : output,
        arlen   : output,
        arsize  : output,
        arburst : output,
        arlock  : output,
        arcache : output,
        arprot  : output,
        arqos   : output,
        arregion: output,
        arvalid : output,
        arready : input ,
        rid     : input ,
        rdata   : input ,
        rresp   : input ,
        rlast   : input ,
        rvalid  : input ,
        rready  : output,
    }

    modport target {
        awid    : input ,
        awaddr  : input ,
        awlen   : input ,
        awsize  : input ,
        awburst : input ,
        awlock  : input ,
        awcache : input ,
        awprot  : input ,
        awqos   : input ,
        awregion: input ,
        awvalid : input ,
        awready : output,
        wdata   : input ,
        wstrb   : input ,
        wlast   : input ,
        wvalid  : input ,
        wready  : output,
        bid     : output,
        bresp   : output,
        bvalid  : output,
        bready  : input ,
        arid    : input ,
        araddr  : input ,
        arlen   : input ,
        arsize  : input ,
        arburst : input ,
        arlock  : input ,
        arcache : input ,
        arprot  : input ,
        arqos   : input ,
        arregion: input ,
        arvalid : input ,
        arready : output,
        rid     : output,
        rdata   : output,
        rresp   : output,
        rlast   : output,
        rvalid  : output,
        rready  : input ,
    }
}

/// Validates and decodes a complete AXI4 burst.
///
/// The decoder rejects reserved burst types, transfers wider than the data
/// bus, FIXED bursts longer than 16 beats, invalid WRAP lengths or alignment,
/// address overflow, and any burst crossing a 4 KiB boundary. A transfer is
/// routed only when every byte lies inside one target window.
module Axi4BurstDecoder (
    addr        : input  logic<16>,
    len         : input  logic<8> ,
    size        : input  logic<3> ,
    burst       : input  logic<2> ,
    target0     : output logic    ,
    target1     : output logic    ,
    decode_error: output logic    ,
) {
    var extended_address: logic<17>;
    var aligned_address : logic<17>;
    var beat_bytes      : logic<17>;
    var burst_bytes     : logic<17>;
    var last_address    : logic<17>;
    var protocol_valid  : logic    ;

    always_comb {
        extended_address = {1'b0, addr};
        beat_bytes       = 17'h00001 << size;
        burst_bytes      = ({9'h000, len} + 17'h00001) << size;
        aligned_address  = extended_address & ~(beat_bytes - 17'h00001);
        last_address     = aligned_address + beat_bytes - 17'h00001;
        protocol_valid   = size <= 3'd2;

        case burst {
            2'b00: {
                // FIXED repeats the same aligned transfer footprint.
                protocol_valid = protocol_valid && (len <: 8'd16);
            }
            2'b01: {
                last_address = aligned_address + burst_bytes - 17'h00001;
            }
            2'b10: {
                last_address   = (extended_address & ~(burst_bytes - 17'h00001)) + burst_bytes - 17'h00001;
                protocol_valid = protocol_valid && ((len == 8'd1) || (len == 8'd3) || (len == 8'd7) || (len == 8'd15))
                    && ((extended_address & (beat_bytes - 17'h00001)) == 17'h00000);
            }
            default: {
                protocol_valid = 1'b0;
            }
        }

        protocol_valid = protocol_valid && !last_address[16] && (addr[15:12] == last_address[15:12]);
        target0        = protocol_valid && (addr <: 16'h4000) && (last_address <: 17'h04000);
        target1        = protocol_valid && (addr >= 16'h8000) && (last_address <: 17'h0c000);
        decode_error   = !target0 && !target1;
    }
}

/// Statically elaborated bank of independent burst decoders.
///
/// Veryl expands the parameter-bounded generate loop in analyzer AIR, so Struo
/// receives ordinary instances without generating an intermediate source file.
module Axi4BurstDecoderBank::<PORTS: u32 = 2> (
    addr        : input  logic<PORTS * 16>,
    len         : input  logic<PORTS * 8> ,
    size        : input  logic<PORTS * 3> ,
    burst       : input  logic<PORTS * 2> ,
    target0     : output logic<PORTS>     ,
    target1     : output logic<PORTS>     ,
    decode_error: output logic<PORTS>     ,
) {
    for i in 0..PORTS :decoder {
        inst unit: Axi4BurstDecoder (
            addr        : addr[i * 16+:16],
            len         : len[i * 8+:8]   ,
            size        : size[i * 3+:3]  ,
            burst       : burst[i * 2+:2] ,
            target0     : target0[i]      ,
            target1     : target1[i]      ,
            decode_error: decode_error[i] ,
        );
    }
}

/// Fixed two-initiator, two-target AXI4 crossbar.
///
/// Each initiator may have two reads and two writes outstanding, provided their
/// IDs differ. The downstream ID gains an owner bit so responses can return out
/// of order across IDs. Target 0 owns 0x0000-0x3fff and target 1 owns
/// 0x8000-0xbfff. Unmapped bursts complete locally with DECERR.
module Axi4Crossbar2x2 (
    clk  : input   clock_posedge                        ,
    rst_n: input   reset_async_low                      ,
    s0   : modport Axi4Interface::<16, 32, 4>::target   ,
    s1   : modport Axi4Interface::<16, 32, 4>::target   ,
    m0   : modport Axi4Interface::<16, 32, 5>::initiator,
    m1   : modport Axi4Interface::<16, 32, 5>::initiator,
) {
    var s0_aw_full       : logic    ;
    var s0_aw_payload    : logic<49>;
    var s0_w_full        : logic    ;
    var s0_w_payload     : logic<37>;
    var s0_w_busy        : logic    ;
    var s0_w_error_active: logic    ;
    var s0_w_error_valid : logic    ;
    var s0_w_error_id    : logic<4> ;
    var s0_w_slot0_valid : logic    ;
    var s0_w_slot0_id    : logic<4> ;
    var s0_w_slot1_valid : logic    ;
    var s0_w_slot1_id    : logic<4> ;
    var s1_aw_full       : logic    ;
    var s1_aw_payload    : logic<49>;
    var s1_w_full        : logic    ;
    var s1_w_payload     : logic<37>;
    var s1_w_busy        : logic    ;
    var s1_w_error_active: logic    ;
    var s1_w_error_valid : logic    ;
    var s1_w_error_id    : logic<4> ;
    var s1_w_slot0_valid : logic    ;
    var s1_w_slot0_id    : logic<4> ;
    var s1_w_slot1_valid : logic    ;
    var s1_w_slot1_id    : logic<4> ;

    var wm0_active    : logic    ;
    var wm0_owner     : logic    ;
    var wm0_aw_sent   : logic    ;
    var wm0_w_done    : logic    ;
    var wm0_aw_payload: logic<49>;
    var wm0_rr        : logic    ;
    var wm1_active    : logic    ;
    var wm1_owner     : logic    ;
    var wm1_aw_sent   : logic    ;
    var wm1_w_done    : logic    ;
    var wm1_aw_payload: logic<49>;
    var wm1_rr        : logic    ;

    var s0_r_error_valid    : logic   ;
    var s0_r_error_id       : logic<4>;
    var s0_r_error_remaining: logic<8>;
    var s0_r_slot0_valid    : logic   ;
    var s0_r_slot0_id       : logic<4>;
    var s0_r_slot1_valid    : logic   ;
    var s0_r_slot1_id       : logic<4>;
    var s1_r_error_valid    : logic   ;
    var s1_r_error_id       : logic<4>;
    var s1_r_error_remaining: logic<8>;
    var s1_r_slot0_valid    : logic   ;
    var s1_r_slot0_id       : logic<4>;
    var s1_r_slot1_valid    : logic   ;
    var s1_r_slot1_id       : logic<4>;

    var rm0_active    : logic    ;
    var rm0_owner     : logic    ;
    var rm0_ar_payload: logic<49>;
    var rm0_rr        : logic    ;
    var rm1_active    : logic    ;
    var rm1_owner     : logic    ;
    var rm1_ar_payload: logic<49>;
    var rm1_rr        : logic    ;

    var wg00            : logic;
    var wg01            : logic;
    var wg10            : logic;
    var wg11            : logic;
    var wr00            : logic;
    var wr01            : logic;
    var wr10            : logic;
    var wr11            : logic;
    var w_dispatch0     : logic;
    var w_dispatch1     : logic;
    var w_error_grant0  : logic;
    var w_error_grant1  : logic;
    var w_pop0          : logic;
    var w_pop1          : logic;
    var w_error_consume0: logic;
    var w_error_consume1: logic;
    var wm0_aw_handshake: logic;
    var wm0_w_handshake : logic;
    var wm0_issue_done  : logic;
    var wm1_aw_handshake: logic;
    var wm1_w_handshake : logic;
    var wm1_issue_done  : logic;

    var s0_w_can_accept: logic;
    var s1_w_can_accept: logic;
    var s0_w_id_busy   : logic;
    var s1_w_id_busy   : logic;
    var s0_b_from_m0   : logic;
    var s0_b_from_m1   : logic;
    var s1_b_from_m0   : logic;
    var s1_b_from_m1   : logic;

    var rg00              : logic;
    var rg01              : logic;
    var rg10              : logic;
    var rg11              : logic;
    var rr00              : logic;
    var rr01              : logic;
    var rr10              : logic;
    var rr11              : logic;
    var r_accept0         : logic;
    var r_accept1         : logic;
    var r_error_accept0   : logic;
    var r_error_accept1   : logic;
    var r_error_handshake0: logic;
    var r_error_handshake1: logic;
    var rm0_ar_handshake  : logic;
    var rm1_ar_handshake  : logic;
    var s0_r_can_accept   : logic;
    var s1_r_can_accept   : logic;
    var s0_r_id_busy      : logic;
    var s1_r_id_busy      : logic;
    var s0_r_from_m0      : logic;
    var s0_r_from_m1      : logic;
    var s1_r_from_m0      : logic;
    var s1_r_from_m1      : logic;

    var s0_aw_target0     : logic;
    var s0_aw_target1     : logic;
    var s0_aw_decode_error: logic;
    var s1_aw_target0     : logic;
    var s1_aw_target1     : logic;
    var s1_aw_decode_error: logic;
    var s0_ar_target0     : logic;
    var s0_ar_target1     : logic;
    var s0_ar_decode_error: logic;
    var s1_ar_target0     : logic;
    var s1_ar_target1     : logic;
    var s1_ar_decode_error: logic;

    inst aw_decoders: Axi4BurstDecoderBank::<2> (
        addr        : {s1_aw_payload[44:29], s0_aw_payload[44:29]},
        len         : {s1_aw_payload[28:21], s0_aw_payload[28:21]},
        size        : {s1_aw_payload[20:18], s0_aw_payload[20:18]},
        burst       : {s1_aw_payload[17:16], s0_aw_payload[17:16]},
        target0     : {s1_aw_target0, s0_aw_target0},
        target1     : {s1_aw_target1, s0_aw_target1},
        decode_error: {s1_aw_decode_error, s0_aw_decode_error},
    );
    inst ar_decoders: Axi4BurstDecoderBank::<2> (
        addr        : {s1.araddr, s0.araddr},
        len         : {s1.arlen, s0.arlen},
        size        : {s1.arsize, s0.arsize},
        burst       : {s1.arburst, s0.arburst},
        target0     : {s1_ar_target0, s0_ar_target0},
        target1     : {s1_ar_target1, s0_ar_target1},
        decode_error: {s1_ar_decode_error, s0_ar_decode_error},
    );

    always_comb {
        // Write address admission reserves one of two per-initiator ID slots.
        s0_w_id_busy    = (s0_w_slot0_valid && (s0_w_slot0_id == s0.awid))
            || (s0_w_slot1_valid && (s0_w_slot1_id == s0.awid));
        s1_w_id_busy    = (s1_w_slot0_valid && (s1_w_slot0_id == s1.awid))
            || (s1_w_slot1_valid && (s1_w_slot1_id == s1.awid));
        s0_w_can_accept = (!s0_w_slot0_valid || !s0_w_slot1_valid) && !s0_w_id_busy;
        s1_w_can_accept = (!s1_w_slot0_valid || !s1_w_slot1_valid) && !s1_w_id_busy;
        s0.awready      = !s0_aw_full && s0_w_can_accept;
        s1.awready      = !s1_aw_full && s1_w_can_accept;

        // A target owns a W stream only through the final W beat. B responses
        // are routed independently by the owner bit added to the downstream ID.
        wr00 = s0_aw_full && s0_w_full && !s0_w_busy && s0_aw_target0;
        wr01 = s1_aw_full && s1_w_full && !s1_w_busy && s1_aw_target0;
        wr10 = s0_aw_full && s0_w_full && !s0_w_busy && s0_aw_target1;
        wr11 = s1_aw_full && s1_w_full && !s1_w_busy && s1_aw_target1;
        wg01 = !wm0_active && wr01
            && (!wr00 || (s1_aw_payload[7:4] >: s0_aw_payload[7:4])
                || ((s1_aw_payload[7:4] == s0_aw_payload[7:4]) && wm0_rr));
        wg00 = !wm0_active && wr00 && !wg01;
        wg11 = !wm1_active && wr11
            && (!wr10 || (s1_aw_payload[7:4] >: s0_aw_payload[7:4])
                || ((s1_aw_payload[7:4] == s0_aw_payload[7:4]) && wm1_rr));
        wg10 = !wm1_active && wr10 && !wg11;

        w_error_grant0 = s0_aw_full && s0_w_full && !s0_w_busy && !s0_w_error_active && !s0_w_error_valid
            && s0_aw_decode_error;
        w_error_grant1 = s1_aw_full && s1_w_full && !s1_w_busy && !s1_w_error_active && !s1_w_error_valid
            && s1_aw_decode_error;
        w_dispatch0    = wg00 || wg10 || w_error_grant0;
        w_dispatch1    = wg01 || wg11 || w_error_grant1;

        m0.awid          = {wm0_owner, wm0_aw_payload[48:45]};
        m0.awaddr        = wm0_aw_payload[44:29];
        m0.awlen         = wm0_aw_payload[28:21];
        m0.awsize        = wm0_aw_payload[20:18];
        m0.awburst       = wm0_aw_payload[17:16];
        m0.awlock        = wm0_aw_payload[15];
        m0.awcache       = wm0_aw_payload[14:11];
        m0.awprot        = wm0_aw_payload[10:8];
        m0.awqos         = wm0_aw_payload[7:4];
        m0.awregion      = wm0_aw_payload[3:0];
        m0.awvalid       = wm0_active && !wm0_aw_sent;
        m0.wdata         = if wm0_owner ? s1_w_payload[36:5] : s0_w_payload[36:5];
        m0.wstrb         = if wm0_owner ? s1_w_payload[4:1] : s0_w_payload[4:1];
        m0.wlast         = if wm0_owner ? s1_w_payload[0] : s0_w_payload[0];
        m0.wvalid        = wm0_active && !wm0_w_done && (if wm0_owner ? s1_w_full : s0_w_full);
        wm0_aw_handshake = m0.awvalid && m0.awready;
        wm0_w_handshake  = m0.wvalid && m0.wready;
        wm0_issue_done   = wm0_active && (wm0_aw_sent || wm0_aw_handshake)
            && (wm0_w_done || (wm0_w_handshake && m0.wlast));

        m1.awid          = {wm1_owner, wm1_aw_payload[48:45]};
        m1.awaddr        = wm1_aw_payload[44:29];
        m1.awlen         = wm1_aw_payload[28:21];
        m1.awsize        = wm1_aw_payload[20:18];
        m1.awburst       = wm1_aw_payload[17:16];
        m1.awlock        = wm1_aw_payload[15];
        m1.awcache       = wm1_aw_payload[14:11];
        m1.awprot        = wm1_aw_payload[10:8];
        m1.awqos         = wm1_aw_payload[7:4];
        m1.awregion      = wm1_aw_payload[3:0];
        m1.awvalid       = wm1_active && !wm1_aw_sent;
        m1.wdata         = if wm1_owner ? s1_w_payload[36:5] : s0_w_payload[36:5];
        m1.wstrb         = if wm1_owner ? s1_w_payload[4:1] : s0_w_payload[4:1];
        m1.wlast         = if wm1_owner ? s1_w_payload[0] : s0_w_payload[0];
        m1.wvalid        = wm1_active && !wm1_w_done && (if wm1_owner ? s1_w_full : s0_w_full);
        wm1_aw_handshake = m1.awvalid && m1.awready;
        wm1_w_handshake  = m1.wvalid && m1.wready;
        wm1_issue_done   = wm1_active && (wm1_aw_sent || wm1_aw_handshake)
            && (wm1_w_done || (wm1_w_handshake && m1.wlast));

        w_error_consume0 = s0_w_error_active && s0_w_full;
        w_error_consume1 = s1_w_error_active && s1_w_full;
        w_pop0           = w_error_consume0 || (wm0_w_handshake && !wm0_owner) || (wm1_w_handshake && !wm1_owner);
        w_pop1           = w_error_consume1 || (wm0_w_handshake && wm0_owner) || (wm1_w_handshake && wm1_owner);
        s0.wready        = !s0_w_full || w_pop0;
        s1.wready        = !s1_w_full || w_pop1;

        s0_b_from_m0 = m0.bvalid && !m0.bid[4];
        s0_b_from_m1 = m1.bvalid && !m1.bid[4];
        s1_b_from_m0 = m0.bvalid && m0.bid[4];
        s1_b_from_m1 = m1.bvalid && m1.bid[4];
        s0.bvalid    = s0_w_error_valid || s0_b_from_m0 || s0_b_from_m1;
        s0.bid       = if s0_w_error_valid ? s0_w_error_id : if s0_b_from_m0 ? m0.bid[3:0] : m1.bid[3:0];
        s0.bresp     = if s0_w_error_valid ? 2'b11 : if s0_b_from_m0 ? m0.bresp : m1.bresp;
        s1.bvalid    = s1_w_error_valid || s1_b_from_m0 || s1_b_from_m1;
        s1.bid       = if s1_w_error_valid ? s1_w_error_id : if s1_b_from_m0 ? m0.bid[3:0] : m1.bid[3:0];
        s1.bresp     = if s1_w_error_valid ? 2'b11 : if s1_b_from_m0 ? m0.bresp : m1.bresp;
        m0.bready    = m0.bvalid
            && (if m0.bid[4] ? (!s1_w_error_valid && s1.bready) : (!s0_w_error_valid && s0.bready));
        m1.bready    = m1.bvalid
            && (if m1.bid[4] ?
                (!s1_w_error_valid && !s1_b_from_m0 && s1.bready)
            :
                (!s0_w_error_valid && !s0_b_from_m0 && s0.bready)
            );

        // Read address admission also reserves two unique-ID slots. The target
        // address skid registers are released after AR, not after the R burst.
        s0_r_id_busy    = (s0_r_slot0_valid && (s0_r_slot0_id == s0.arid))
            || (s0_r_slot1_valid && (s0_r_slot1_id == s0.arid));
        s1_r_id_busy    = (s1_r_slot0_valid && (s1_r_slot0_id == s1.arid))
            || (s1_r_slot1_valid && (s1_r_slot1_id == s1.arid));
        s0_r_can_accept = (!s0_r_slot0_valid || !s0_r_slot1_valid) && !s0_r_id_busy;
        s1_r_can_accept = (!s1_r_slot0_valid || !s1_r_slot1_valid) && !s1_r_id_busy;
        rr00            = s0.arvalid && s0_r_can_accept && s0_ar_target0;
        rr01            = s1.arvalid && s1_r_can_accept && s1_ar_target0;
        rr10            = s0.arvalid && s0_r_can_accept && s0_ar_target1;
        rr11            = s1.arvalid && s1_r_can_accept && s1_ar_target1;
        rg01            = !rm0_active && rr01
            && (!rr00 || (s1.arqos >: s0.arqos) || ((s1.arqos == s0.arqos) && rm0_rr));
        rg00            = !rm0_active && rr00 && !rg01;
        rg11            = !rm1_active && rr11
            && (!rr10 || (s1.arqos >: s0.arqos) || ((s1.arqos == s0.arqos) && rm1_rr));
        rg10            = !rm1_active && rr10 && !rg11;
        r_error_accept0 = s0.arvalid && s0_r_can_accept && !s0_r_error_valid && s0_ar_decode_error;
        r_error_accept1 = s1.arvalid && s1_r_can_accept && !s1_r_error_valid && s1_ar_decode_error;
        r_accept0       = rg00 || rg10 || r_error_accept0;
        r_accept1       = rg01 || rg11 || r_error_accept1;
        s0.arready      = r_accept0;
        s1.arready      = r_accept1;

        m0.arid          = {rm0_owner, rm0_ar_payload[48:45]};
        m0.araddr        = rm0_ar_payload[44:29];
        m0.arlen         = rm0_ar_payload[28:21];
        m0.arsize        = rm0_ar_payload[20:18];
        m0.arburst       = rm0_ar_payload[17:16];
        m0.arlock        = rm0_ar_payload[15];
        m0.arcache       = rm0_ar_payload[14:11];
        m0.arprot        = rm0_ar_payload[10:8];
        m0.arqos         = rm0_ar_payload[7:4];
        m0.arregion      = rm0_ar_payload[3:0];
        m0.arvalid       = rm0_active;
        rm0_ar_handshake = m0.arvalid && m0.arready;

        m1.arid          = {rm1_owner, rm1_ar_payload[48:45]};
        m1.araddr        = rm1_ar_payload[44:29];
        m1.arlen         = rm1_ar_payload[28:21];
        m1.arsize        = rm1_ar_payload[20:18];
        m1.arburst       = rm1_ar_payload[17:16];
        m1.arlock        = rm1_ar_payload[15];
        m1.arcache       = rm1_ar_payload[14:11];
        m1.arprot        = rm1_ar_payload[10:8];
        m1.arqos         = rm1_ar_payload[7:4];
        m1.arregion      = rm1_ar_payload[3:0];
        m1.arvalid       = rm1_active;
        rm1_ar_handshake = m1.arvalid && m1.arready;

        s0_r_from_m0       = m0.rvalid && !m0.rid[4];
        s0_r_from_m1       = m1.rvalid && !m1.rid[4];
        s1_r_from_m0       = m0.rvalid && m0.rid[4];
        s1_r_from_m1       = m1.rvalid && m1.rid[4];
        s0.rvalid          = s0_r_error_valid || s0_r_from_m0 || s0_r_from_m1;
        s0.rid             = if s0_r_error_valid ? s0_r_error_id : if s0_r_from_m0 ? m0.rid[3:0] : m1.rid[3:0];
        s0.rdata           = if s0_r_error_valid ? 32'h00000000 : if s0_r_from_m0 ? m0.rdata : m1.rdata;
        s0.rresp           = if s0_r_error_valid ? 2'b11 : if s0_r_from_m0 ? m0.rresp : m1.rresp;
        s0.rlast           = if s0_r_error_valid ?
            (s0_r_error_remaining == 8'h00)
        : if s0_r_from_m0 ?
            m0.rlast
        :
            m1.rlast
        ;
        s1.rvalid          = s1_r_error_valid || s1_r_from_m0 || s1_r_from_m1;
        s1.rid             = if s1_r_error_valid ? s1_r_error_id : if s1_r_from_m0 ? m0.rid[3:0] : m1.rid[3:0];
        s1.rdata           = if s1_r_error_valid ? 32'h00000000 : if s1_r_from_m0 ? m0.rdata : m1.rdata;
        s1.rresp           = if s1_r_error_valid ? 2'b11 : if s1_r_from_m0 ? m0.rresp : m1.rresp;
        s1.rlast           = if s1_r_error_valid ?
            (s1_r_error_remaining == 8'h00)
        : if s1_r_from_m0 ?
            m0.rlast
        :
            m1.rlast
        ;
        m0.rready          = m0.rvalid
            && (if m0.rid[4] ? (!s1_r_error_valid && s1.rready) : (!s0_r_error_valid && s0.rready));
        m1.rready          = m1.rvalid
            && (if m1.rid[4] ?
                (!s1_r_error_valid && !s1_r_from_m0 && s1.rready)
            :
                (!s0_r_error_valid && !s0_r_from_m0 && s0.rready)
            );
        r_error_handshake0 = s0_r_error_valid && s0.rready;
        r_error_handshake1 = s1_r_error_valid && s1.rready;
    }

    always_ff (clk, rst_n) {
        if_reset {
            s0_aw_full           = 1'b0;
            s0_aw_payload        = 49'b0;
            s0_w_full            = 1'b0;
            s0_w_payload         = 37'b0;
            s0_w_busy            = 1'b0;
            s0_w_error_active    = 1'b0;
            s0_w_error_valid     = 1'b0;
            s0_w_error_id        = 4'b0;
            s0_w_slot0_valid     = 1'b0;
            s0_w_slot0_id        = 4'b0;
            s0_w_slot1_valid     = 1'b0;
            s0_w_slot1_id        = 4'b0;
            s1_aw_full           = 1'b0;
            s1_aw_payload        = 49'b0;
            s1_w_full            = 1'b0;
            s1_w_payload         = 37'b0;
            s1_w_busy            = 1'b0;
            s1_w_error_active    = 1'b0;
            s1_w_error_valid     = 1'b0;
            s1_w_error_id        = 4'b0;
            s1_w_slot0_valid     = 1'b0;
            s1_w_slot0_id        = 4'b0;
            s1_w_slot1_valid     = 1'b0;
            s1_w_slot1_id        = 4'b0;
            wm0_active           = 1'b0;
            wm0_owner            = 1'b0;
            wm0_aw_sent          = 1'b0;
            wm0_w_done           = 1'b0;
            wm0_aw_payload       = 49'b0;
            wm0_rr               = 1'b0;
            wm1_active           = 1'b0;
            wm1_owner            = 1'b0;
            wm1_aw_sent          = 1'b0;
            wm1_w_done           = 1'b0;
            wm1_aw_payload       = 49'b0;
            wm1_rr               = 1'b0;
            s0_r_error_valid     = 1'b0;
            s0_r_error_id        = 4'b0;
            s0_r_error_remaining = 8'b0;
            s0_r_slot0_valid     = 1'b0;
            s0_r_slot0_id        = 4'b0;
            s0_r_slot1_valid     = 1'b0;
            s0_r_slot1_id        = 4'b0;
            s1_r_error_valid     = 1'b0;
            s1_r_error_id        = 4'b0;
            s1_r_error_remaining = 8'b0;
            s1_r_slot0_valid     = 1'b0;
            s1_r_slot0_id        = 4'b0;
            s1_r_slot1_valid     = 1'b0;
            s1_r_slot1_id        = 4'b0;
            rm0_active           = 1'b0;
            rm0_owner            = 1'b0;
            rm0_ar_payload       = 49'b0;
            rm0_rr               = 1'b0;
            rm1_active           = 1'b0;
            rm1_owner            = 1'b0;
            rm1_ar_payload       = 49'b0;
            rm1_rr               = 1'b0;
        } else {
            if s0.awvalid && s0.awready {
                s0_aw_full    = 1'b1;
                s0_aw_payload = {
                    s0.awid, s0.awaddr, s0.awlen, s0.awsize, s0.awburst, s0.awlock, s0.awcache, s0.awprot, s0.awqos,
                    s0.awregion
                };
                if !s0_w_slot0_valid {
                    s0_w_slot0_valid = 1'b1;
                    s0_w_slot0_id    = s0.awid;
                } else {
                    s0_w_slot1_valid = 1'b1;
                    s0_w_slot1_id    = s0.awid;
                }
            }
            if s1.awvalid && s1.awready {
                s1_aw_full    = 1'b1;
                s1_aw_payload = {
                    s1.awid, s1.awaddr, s1.awlen, s1.awsize, s1.awburst, s1.awlock, s1.awcache, s1.awprot, s1.awqos,
                    s1.awregion
                };
                if !s1_w_slot0_valid {
                    s1_w_slot0_valid = 1'b1;
                    s1_w_slot0_id    = s1.awid;
                } else {
                    s1_w_slot1_valid = 1'b1;
                    s1_w_slot1_id    = s1.awid;
                }
            }
            if w_pop0 {
                s0_w_full = 1'b0;
            }
            if s0.wvalid && s0.wready {
                s0_w_full    = 1'b1;
                s0_w_payload = {s0.wdata, s0.wstrb, s0.wlast};
            }
            if w_pop1 {
                s1_w_full = 1'b0;
            }
            if s1.wvalid && s1.wready {
                s1_w_full    = 1'b1;
                s1_w_payload = {s1.wdata, s1.wstrb, s1.wlast};
            }

            if w_dispatch0 {
                s0_aw_full = 1'b0;
                s0_w_busy  = 1'b1;
            }
            if w_dispatch1 {
                s1_aw_full = 1'b0;
                s1_w_busy  = 1'b1;
            }
            if s0.bvalid && s0.bready {
                s0_w_error_valid = 1'b0;
                if s0_w_slot0_valid && (s0_w_slot0_id == s0.bid) {
                    s0_w_slot0_valid = 1'b0;
                }
                if s0_w_slot1_valid && (s0_w_slot1_id == s0.bid) {
                    s0_w_slot1_valid = 1'b0;
                }
            }
            if s1.bvalid && s1.bready {
                s1_w_error_valid = 1'b0;
                if s1_w_slot0_valid && (s1_w_slot0_id == s1.bid) {
                    s1_w_slot0_valid = 1'b0;
                }
                if s1_w_slot1_valid && (s1_w_slot1_id == s1.bid) {
                    s1_w_slot1_valid = 1'b0;
                }
            }
            if w_error_grant0 {
                s0_w_error_active = 1'b1;
                s0_w_error_id     = s0_aw_payload[48:45];
            }
            if w_error_consume0 && s0_w_payload[0] {
                s0_w_error_active = 1'b0;
                s0_w_error_valid  = 1'b1;
                s0_w_busy         = 1'b0;
            }
            if w_error_grant1 {
                s1_w_error_active = 1'b1;
                s1_w_error_id     = s1_aw_payload[48:45];
            }
            if w_error_consume1 && s1_w_payload[0] {
                s1_w_error_active = 1'b0;
                s1_w_error_valid  = 1'b1;
                s1_w_busy         = 1'b0;
            }

            if wg00 || wg01 {
                wm0_active     = 1'b1;
                wm0_owner      = wg01;
                wm0_aw_sent    = 1'b0;
                wm0_w_done     = 1'b0;
                wm0_aw_payload = if wg01 ? s1_aw_payload : s0_aw_payload;
            }
            if wm0_aw_handshake {
                wm0_aw_sent = 1'b1;
            }
            if wm0_w_handshake && m0.wlast {
                wm0_w_done = 1'b1;
            }
            if wm0_issue_done {
                wm0_active = 1'b0;
                wm0_rr     = !wm0_owner;
                if wm0_owner {
                    s1_w_busy = 1'b0;
                } else {
                    s0_w_busy = 1'b0;
                }
            }
            if wg10 || wg11 {
                wm1_active     = 1'b1;
                wm1_owner      = wg11;
                wm1_aw_sent    = 1'b0;
                wm1_w_done     = 1'b0;
                wm1_aw_payload = if wg11 ? s1_aw_payload : s0_aw_payload;
            }
            if wm1_aw_handshake {
                wm1_aw_sent = 1'b1;
            }
            if wm1_w_handshake && m1.wlast {
                wm1_w_done = 1'b1;
            }
            if wm1_issue_done {
                wm1_active = 1'b0;
                wm1_rr     = !wm1_owner;
                if wm1_owner {
                    s1_w_busy = 1'b0;
                } else {
                    s0_w_busy = 1'b0;
                }
            }

            if r_accept0 {
                if !s0_r_slot0_valid {
                    s0_r_slot0_valid = 1'b1;
                    s0_r_slot0_id    = s0.arid;
                } else {
                    s0_r_slot1_valid = 1'b1;
                    s0_r_slot1_id    = s0.arid;
                }
            }
            if r_accept1 {
                if !s1_r_slot0_valid {
                    s1_r_slot0_valid = 1'b1;
                    s1_r_slot0_id    = s1.arid;
                } else {
                    s1_r_slot1_valid = 1'b1;
                    s1_r_slot1_id    = s1.arid;
                }
            }
            if s0.rvalid && s0.rready && s0.rlast {
                if s0_r_slot0_valid && (s0_r_slot0_id == s0.rid) {
                    s0_r_slot0_valid = 1'b0;
                }
                if s0_r_slot1_valid && (s0_r_slot1_id == s0.rid) {
                    s0_r_slot1_valid = 1'b0;
                }
            }
            if s1.rvalid && s1.rready && s1.rlast {
                if s1_r_slot0_valid && (s1_r_slot0_id == s1.rid) {
                    s1_r_slot0_valid = 1'b0;
                }
                if s1_r_slot1_valid && (s1_r_slot1_id == s1.rid) {
                    s1_r_slot1_valid = 1'b0;
                }
            }
            if r_error_accept0 {
                s0_r_error_valid     = 1'b1;
                s0_r_error_id        = s0.arid;
                s0_r_error_remaining = s0.arlen;
            }
            if r_error_handshake0 {
                if s0_r_error_remaining == 8'h00 {
                    s0_r_error_valid = 1'b0;
                } else {
                    s0_r_error_remaining = s0_r_error_remaining - 8'h01;
                }
            }
            if r_error_accept1 {
                s1_r_error_valid     = 1'b1;
                s1_r_error_id        = s1.arid;
                s1_r_error_remaining = s1.arlen;
            }
            if r_error_handshake1 {
                if s1_r_error_remaining == 8'h00 {
                    s1_r_error_valid = 1'b0;
                } else {
                    s1_r_error_remaining = s1_r_error_remaining - 8'h01;
                }
            }

            if rg00 || rg01 {
                rm0_active     = 1'b1;
                rm0_owner      = rg01;
                rm0_ar_payload = if rg01 ?
                    {s1.arid, s1.araddr, s1.arlen, s1.arsize, s1.arburst, s1.arlock, s1.arcache, s1.arprot, s1.arqos, s1.arregion}
                :
                    {s0.arid, s0.araddr, s0.arlen, s0.arsize, s0.arburst, s0.arlock, s0.arcache, s0.arprot, s0.arqos, s0.arregion}
                ;
            }
            if rm0_ar_handshake {
                rm0_active = 1'b0;
                rm0_rr     = !rm0_owner;
            }
            if rg10 || rg11 {
                rm1_active     = 1'b1;
                rm1_owner      = rg11;
                rm1_ar_payload = if rg11 ?
                    {s1.arid, s1.araddr, s1.arlen, s1.arsize, s1.arburst, s1.arlock, s1.arcache, s1.arprot, s1.arqos, s1.arregion}
                :
                    {s0.arid, s0.araddr, s0.arlen, s0.arsize, s0.arburst, s0.arlock, s0.arcache, s0.arprot, s0.arqos, s0.arregion}
                ;
            }
            if rm1_ar_handshake {
                rm1_active = 1'b0;
                rm1_rr     = !rm1_owner;
            }
        }
    }
}

/// Closed-system synthesis top that verifies one routed AXI4 read transaction.
module Axi4CrossbarSelfTest (
    clk   : input  clock_posedge  ,
    rst_n : input  reset_async_low,
    passed: output logic          ,
    failed: output logic          ,
) {
    inst s0      : Axi4Interface::<16, 32, 4>;
    inst s1      : Axi4Interface::<16, 32, 4>;
    inst m0      : Axi4Interface::<16, 32, 5>;
    inst m1      : Axi4Interface::<16, 32, 5>;
    inst crossbar: Axi4Crossbar2x2 (
        clk  : clk  ,
        rst_n: rst_n,
        s0   : s0   ,
        s1   : s1   ,
        m0   : m0   ,
        m1   : m1   ,
    );

    var request_active: logic   ;
    var response_valid: logic   ;
    var response_id   : logic<5>;

    always_comb {
        s0.awid     = 4'h0;
        s0.awaddr   = 16'h0000;
        s0.awlen    = 8'h00;
        s0.awsize   = 3'h2;
        s0.awburst  = 2'h1;
        s0.awlock   = 1'b0;
        s0.awcache  = 4'h0;
        s0.awprot   = 3'h0;
        s0.awqos    = 4'h0;
        s0.awregion = 4'h0;
        s0.awvalid  = 1'b0;
        s0.wdata    = 32'h00000000;
        s0.wstrb    = 4'h0;
        s0.wlast    = 1'b0;
        s0.wvalid   = 1'b0;
        s0.bready   = 1'b1;
        s0.arid     = 4'h3;
        s0.araddr   = 16'h0120;
        s0.arlen    = 8'h00;
        s0.arsize   = 3'h2;
        s0.arburst  = 2'h1;
        s0.arlock   = 1'b0;
        s0.arcache  = 4'h0;
        s0.arprot   = 3'h0;
        s0.arqos    = 4'h0;
        s0.arregion = 4'h0;
        s0.arvalid  = request_active;
        s0.rready   = 1'b1;

        s1.awid     = 4'h0;
        s1.awaddr   = 16'h0000;
        s1.awlen    = 8'h00;
        s1.awsize   = 3'h2;
        s1.awburst  = 2'h1;
        s1.awlock   = 1'b0;
        s1.awcache  = 4'h0;
        s1.awprot   = 3'h0;
        s1.awqos    = 4'h0;
        s1.awregion = 4'h0;
        s1.awvalid  = 1'b0;
        s1.wdata    = 32'h00000000;
        s1.wstrb    = 4'h0;
        s1.wlast    = 1'b0;
        s1.wvalid   = 1'b0;
        s1.bready   = 1'b1;
        s1.arid     = 4'h0;
        s1.araddr   = 16'h0000;
        s1.arlen    = 8'h00;
        s1.arsize   = 3'h2;
        s1.arburst  = 2'h1;
        s1.arlock   = 1'b0;
        s1.arcache  = 4'h0;
        s1.arprot   = 3'h0;
        s1.arqos    = 4'h0;
        s1.arregion = 4'h0;
        s1.arvalid  = 1'b0;
        s1.rready   = 1'b1;

        m0.awready = 1'b1;
        m0.wready  = 1'b1;
        m0.bid     = 5'h00;
        m0.bresp   = 2'b00;
        m0.bvalid  = 1'b0;
        m0.arready = 1'b1;
        m0.rid     = response_id;
        m0.rdata   = 32'h5a5ac33c;
        m0.rresp   = 2'b00;
        m0.rlast   = 1'b1;
        m0.rvalid  = response_valid;

        m1.awready = 1'b1;
        m1.wready  = 1'b1;
        m1.bid     = 5'h00;
        m1.bresp   = 2'b00;
        m1.bvalid  = 1'b0;
        m1.arready = 1'b1;
        m1.rid     = 5'h00;
        m1.rdata   = 32'h00000000;
        m1.rresp   = 2'b00;
        m1.rlast   = 1'b0;
        m1.rvalid  = 1'b0;
    }

    always_ff (clk, rst_n) {
        if_reset {
            request_active = 1'b1;
            response_valid = 1'b0;
            response_id    = 5'h00;
            passed         = 1'b0;
            failed         = 1'b0;
        } else {
            if s0.arvalid && s0.arready {
                request_active = 1'b0;
            }
            if m0.arvalid && m0.arready {
                response_valid = 1'b1;
                response_id    = m0.arid;
            }
            if m0.rvalid && m0.rready {
                response_valid = 1'b0;
            }
            if s0.rvalid && s0.rready {
                if (s0.rid == 4'h3) && (s0.rdata == 32'h5a5ac33c) && (s0.rresp == 2'b00) && s0.rlast {
                    passed = 1'b1;
                } else {
                    failed = 1'b1;
                }
            }
        }
    }
}
