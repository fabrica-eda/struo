/// Fixed two-initiator, two-target AXI4 crossbar.
///
/// One read and one write transaction may be outstanding for each initiator
/// and target. Target 0 owns 0x0000-0x3fff and target 1 owns 0x8000-0xbfff.
/// Unmapped bursts complete locally with DECERR.
module Axi4Crossbar2x2 (
    clk  : input clock_posedge  ,
    rst_n: input reset_async_low,

    s0_awid    : input  logic<4> ,
    s0_awaddr  : input  logic<16>,
    s0_awlen   : input  logic<8> ,
    s0_awsize  : input  logic<3> ,
    s0_awburst : input  logic<2> ,
    s0_awlock  : input  logic    ,
    s0_awcache : input  logic<4> ,
    s0_awprot  : input  logic<3> ,
    s0_awqos   : input  logic<4> ,
    s0_awregion: input  logic<4> ,
    s0_awvalid : input  logic    ,
    s0_awready : output logic    ,
    s0_wdata   : input  logic<32>,
    s0_wstrb   : input  logic<4> ,
    s0_wlast   : input  logic    ,
    s0_wvalid  : input  logic    ,
    s0_wready  : output logic    ,
    s0_bid     : output logic<4> ,
    s0_bresp   : output logic<2> ,
    s0_bvalid  : output logic    ,
    s0_bready  : input  logic    ,
    s0_arid    : input  logic<4> ,
    s0_araddr  : input  logic<16>,
    s0_arlen   : input  logic<8> ,
    s0_arsize  : input  logic<3> ,
    s0_arburst : input  logic<2> ,
    s0_arlock  : input  logic    ,
    s0_arcache : input  logic<4> ,
    s0_arprot  : input  logic<3> ,
    s0_arqos   : input  logic<4> ,
    s0_arregion: input  logic<4> ,
    s0_arvalid : input  logic    ,
    s0_arready : output logic    ,
    s0_rid     : output logic<4> ,
    s0_rdata   : output logic<32>,
    s0_rresp   : output logic<2> ,
    s0_rlast   : output logic    ,
    s0_rvalid  : output logic    ,
    s0_rready  : input  logic    ,

    s1_awid    : input  logic<4> ,
    s1_awaddr  : input  logic<16>,
    s1_awlen   : input  logic<8> ,
    s1_awsize  : input  logic<3> ,
    s1_awburst : input  logic<2> ,
    s1_awlock  : input  logic    ,
    s1_awcache : input  logic<4> ,
    s1_awprot  : input  logic<3> ,
    s1_awqos   : input  logic<4> ,
    s1_awregion: input  logic<4> ,
    s1_awvalid : input  logic    ,
    s1_awready : output logic    ,
    s1_wdata   : input  logic<32>,
    s1_wstrb   : input  logic<4> ,
    s1_wlast   : input  logic    ,
    s1_wvalid  : input  logic    ,
    s1_wready  : output logic    ,
    s1_bid     : output logic<4> ,
    s1_bresp   : output logic<2> ,
    s1_bvalid  : output logic    ,
    s1_bready  : input  logic    ,
    s1_arid    : input  logic<4> ,
    s1_araddr  : input  logic<16>,
    s1_arlen   : input  logic<8> ,
    s1_arsize  : input  logic<3> ,
    s1_arburst : input  logic<2> ,
    s1_arlock  : input  logic    ,
    s1_arcache : input  logic<4> ,
    s1_arprot  : input  logic<3> ,
    s1_arqos   : input  logic<4> ,
    s1_arregion: input  logic<4> ,
    s1_arvalid : input  logic    ,
    s1_arready : output logic    ,
    s1_rid     : output logic<4> ,
    s1_rdata   : output logic<32>,
    s1_rresp   : output logic<2> ,
    s1_rlast   : output logic    ,
    s1_rvalid  : output logic    ,
    s1_rready  : input  logic    ,

    m0_awid    : output logic<4> ,
    m0_awaddr  : output logic<16>,
    m0_awlen   : output logic<8> ,
    m0_awsize  : output logic<3> ,
    m0_awburst : output logic<2> ,
    m0_awlock  : output logic    ,
    m0_awcache : output logic<4> ,
    m0_awprot  : output logic<3> ,
    m0_awqos   : output logic<4> ,
    m0_awregion: output logic<4> ,
    m0_awvalid : output logic    ,
    m0_awready : input  logic    ,
    m0_wdata   : output logic<32>,
    m0_wstrb   : output logic<4> ,
    m0_wlast   : output logic    ,
    m0_wvalid  : output logic    ,
    m0_wready  : input  logic    ,
    m0_bid     : input  logic<4> ,
    m0_bresp   : input  logic<2> ,
    m0_bvalid  : input  logic    ,
    m0_bready  : output logic    ,
    m0_arid    : output logic<4> ,
    m0_araddr  : output logic<16>,
    m0_arlen   : output logic<8> ,
    m0_arsize  : output logic<3> ,
    m0_arburst : output logic<2> ,
    m0_arlock  : output logic    ,
    m0_arcache : output logic<4> ,
    m0_arprot  : output logic<3> ,
    m0_arqos   : output logic<4> ,
    m0_arregion: output logic<4> ,
    m0_arvalid : output logic    ,
    m0_arready : input  logic    ,
    m0_rid     : input  logic<4> ,
    m0_rdata   : input  logic<32>,
    m0_rresp   : input  logic<2> ,
    m0_rlast   : input  logic    ,
    m0_rvalid  : input  logic    ,
    m0_rready  : output logic    ,

    m1_awid    : output logic<4> ,
    m1_awaddr  : output logic<16>,
    m1_awlen   : output logic<8> ,
    m1_awsize  : output logic<3> ,
    m1_awburst : output logic<2> ,
    m1_awlock  : output logic    ,
    m1_awcache : output logic<4> ,
    m1_awprot  : output logic<3> ,
    m1_awqos   : output logic<4> ,
    m1_awregion: output logic<4> ,
    m1_awvalid : output logic    ,
    m1_awready : input  logic    ,
    m1_wdata   : output logic<32>,
    m1_wstrb   : output logic<4> ,
    m1_wlast   : output logic    ,
    m1_wvalid  : output logic    ,
    m1_wready  : input  logic    ,
    m1_bid     : input  logic<4> ,
    m1_bresp   : input  logic<2> ,
    m1_bvalid  : input  logic    ,
    m1_bready  : output logic    ,
    m1_arid    : output logic<4> ,
    m1_araddr  : output logic<16>,
    m1_arlen   : output logic<8> ,
    m1_arsize  : output logic<3> ,
    m1_arburst : output logic<2> ,
    m1_arlock  : output logic    ,
    m1_arcache : output logic<4> ,
    m1_arprot  : output logic<3> ,
    m1_arqos   : output logic<4> ,
    m1_arregion: output logic<4> ,
    m1_arvalid : output logic    ,
    m1_arready : input  logic    ,
    m1_rid     : input  logic<4> ,
    m1_rdata   : input  logic<32>,
    m1_rresp   : input  logic<2> ,
    m1_rlast   : input  logic    ,
    m1_rvalid  : input  logic    ,
    m1_rready  : output logic    ,
) {
    var s0_aw_full       : logic    ;
    var s0_aw_payload    : logic<49>;
    var s0_w_full        : logic    ;
    var s0_w_payload     : logic<37>;
    var s0_w_busy        : logic    ;
    var s0_w_error_active: logic    ;
    var s0_w_error_valid : logic    ;
    var s1_aw_full       : logic    ;
    var s1_aw_payload    : logic<49>;
    var s1_w_full        : logic    ;
    var s1_w_payload     : logic<37>;
    var s1_w_busy        : logic    ;
    var s1_w_error_active: logic    ;
    var s1_w_error_valid : logic    ;

    var wm0_active    : logic    ;
    var wm0_owner     : logic    ;
    var wm0_aw_sent   : logic    ;
    var wm0_w_done    : logic    ;
    var wm0_aw_payload: logic<49>;
    var wm0_rr        : logic    ;
    var wm1_active    : logic    ;
    var wm1_owner     : logic    ;
    var wm1_aw_sent   : logic    ;
    var wm1_w_done    : logic    ;
    var wm1_aw_payload: logic<49>;
    var wm1_rr        : logic    ;

    var s0_r_busy           : logic   ;
    var s0_r_error_valid    : logic   ;
    var s0_r_error_id       : logic<4>;
    var s0_r_error_remaining: logic<8>;
    var s1_r_busy           : logic   ;
    var s1_r_error_valid    : logic   ;
    var s1_r_error_id       : logic<4>;
    var s1_r_error_remaining: logic<8>;

    var rm0_active    : logic    ;
    var rm0_owner     : logic    ;
    var rm0_ar_sent   : logic    ;
    var rm0_ar_payload: logic<49>;
    var rm0_rr        : logic    ;
    var rm1_active    : logic    ;
    var rm1_owner     : logic    ;
    var rm1_ar_sent   : logic    ;
    var rm1_ar_payload: logic<49>;
    var rm1_rr        : logic    ;

    var wg00            : logic;
    var wg01            : logic;
    var wg10            : logic;
    var wg11            : logic;
    var w_dispatch0     : logic;
    var w_dispatch1     : logic;
    var w_error_grant0  : logic;
    var w_error_grant1  : logic;
    var w_pop0          : logic;
    var w_pop1          : logic;
    var w_error_consume0: logic;
    var w_error_consume1: logic;
    var wm0_aw_handshake: logic;
    var wm0_w_handshake : logic;
    var wm0_done        : logic;
    var wm1_aw_handshake: logic;
    var wm1_w_handshake : logic;
    var wm1_done        : logic;

    var rg00              : logic;
    var rg01              : logic;
    var rg10              : logic;
    var rg11              : logic;
    var r_accept0         : logic;
    var r_accept1         : logic;
    var r_error_accept0   : logic;
    var r_error_accept1   : logic;
    var r_error_handshake0: logic;
    var r_error_handshake1: logic;
    var rm0_ar_handshake  : logic;
    var rm0_done          : logic;
    var rm1_ar_handshake  : logic;
    var rm1_done          : logic;

    always_comb {
        // Write address decode and round-robin grants.
        wg01 = !wm0_active && s1_aw_full && s1_w_full && !s1_w_busy && (s1_aw_payload[44:29] <: 16'h4000) && (!(s0_aw_full && s0_w_full && !s0_w_busy && (s0_aw_payload[44:29] <: 16'h4000)) || wm0_rr);
        wg00 = !wm0_active && s0_aw_full && s0_w_full && !s0_w_busy && (s0_aw_payload[44:29] <: 16'h4000) && !wg01;
        wg11 = !wm1_active && s1_aw_full && s1_w_full && !s1_w_busy && (s1_aw_payload[44:29] >= 16'h8000) && (s1_aw_payload[44:29] <: 16'hc000) && (!(s0_aw_full && s0_w_full && !s0_w_busy && (s0_aw_payload[44:29] >= 16'h8000) && (s0_aw_payload[44:29] <: 16'hc000)) || wm1_rr);
        wg10 = !wm1_active && s0_aw_full && s0_w_full && !s0_w_busy && (s0_aw_payload[44:29] >= 16'h8000) && (s0_aw_payload[44:29] <: 16'hc000) && !wg11;

        w_error_grant0 = s0_aw_full && s0_w_full && !s0_w_busy && !((s0_aw_payload[44:29] <: 16'h4000) || ((s0_aw_payload[44:29] >= 16'h8000) && (s0_aw_payload[44:29] <: 16'hc000)));
        w_error_grant1 = s1_aw_full && s1_w_full && !s1_w_busy && !((s1_aw_payload[44:29] <: 16'h4000) || ((s1_aw_payload[44:29] >= 16'h8000) && (s1_aw_payload[44:29] <: 16'hc000)));
        w_dispatch0    = wg00 || wg10 || w_error_grant0;
        w_dispatch1    = wg01 || wg11 || w_error_grant1;

        s0_awready = !s0_aw_full && !s0_w_busy;
        s1_awready = !s1_aw_full && !s1_w_busy;

        m0_awid          = wm0_aw_payload[48:45];
        m0_awaddr        = wm0_aw_payload[44:29];
        m0_awlen         = wm0_aw_payload[28:21];
        m0_awsize        = wm0_aw_payload[20:18];
        m0_awburst       = wm0_aw_payload[17:16];
        m0_awlock        = wm0_aw_payload[15];
        m0_awcache       = wm0_aw_payload[14:11];
        m0_awprot        = wm0_aw_payload[10:8];
        m0_awqos         = wm0_aw_payload[7:4];
        m0_awregion      = wm0_aw_payload[3:0];
        m0_awvalid       = wm0_active && !wm0_aw_sent;
        m0_wdata         = if wm0_owner ? s1_w_payload[36:5] : s0_w_payload[36:5];
        m0_wstrb         = if wm0_owner ? s1_w_payload[4:1] : s0_w_payload[4:1];
        m0_wlast         = if wm0_owner ? s1_w_payload[0] : s0_w_payload[0];
        m0_wvalid        = wm0_active && !wm0_w_done && (if wm0_owner ? s1_w_full : s0_w_full);
        m0_bready        = wm0_active && wm0_aw_sent && wm0_w_done && (if wm0_owner ? s1_bready : s0_bready);
        wm0_aw_handshake = m0_awvalid && m0_awready;
        wm0_w_handshake  = m0_wvalid && m0_wready;
        wm0_done         = m0_bvalid && m0_bready;

        m1_awid          = wm1_aw_payload[48:45];
        m1_awaddr        = wm1_aw_payload[44:29];
        m1_awlen         = wm1_aw_payload[28:21];
        m1_awsize        = wm1_aw_payload[20:18];
        m1_awburst       = wm1_aw_payload[17:16];
        m1_awlock        = wm1_aw_payload[15];
        m1_awcache       = wm1_aw_payload[14:11];
        m1_awprot        = wm1_aw_payload[10:8];
        m1_awqos         = wm1_aw_payload[7:4];
        m1_awregion      = wm1_aw_payload[3:0];
        m1_awvalid       = wm1_active && !wm1_aw_sent;
        m1_wdata         = if wm1_owner ? s1_w_payload[36:5] : s0_w_payload[36:5];
        m1_wstrb         = if wm1_owner ? s1_w_payload[4:1] : s0_w_payload[4:1];
        m1_wlast         = if wm1_owner ? s1_w_payload[0] : s0_w_payload[0];
        m1_wvalid        = wm1_active && !wm1_w_done && (if wm1_owner ? s1_w_full : s0_w_full);
        m1_bready        = wm1_active && wm1_aw_sent && wm1_w_done && (if wm1_owner ? s1_bready : s0_bready);
        wm1_aw_handshake = m1_awvalid && m1_awready;
        wm1_w_handshake  = m1_wvalid && m1_wready;
        wm1_done         = m1_bvalid && m1_bready;

        w_error_consume0 = s0_w_error_active && s0_w_full;
        w_error_consume1 = s1_w_error_active && s1_w_full;
        w_pop0           = w_error_consume0 || (wm0_w_handshake && !wm0_owner) || (wm1_w_handshake && !wm1_owner);
        w_pop1           = w_error_consume1 || (wm0_w_handshake && wm0_owner) || (wm1_w_handshake && wm1_owner);
        s0_wready        = !s0_w_full || w_pop0;
        s1_wready        = !s1_w_full || w_pop1;

        s0_bvalid = s0_w_error_valid || (wm0_active && wm0_aw_sent && wm0_w_done && !wm0_owner && m0_bvalid) || (wm1_active && wm1_aw_sent && wm1_w_done && !wm1_owner && m1_bvalid);
        s0_bid    = if s0_w_error_valid ? s0_aw_payload[48:45] : if wm1_active && !wm1_owner ? m1_bid : m0_bid;
        s0_bresp  = if s0_w_error_valid ? 2'b11 : if wm1_active && !wm1_owner ? m1_bresp : m0_bresp;
        s1_bvalid = s1_w_error_valid || (wm0_active && wm0_aw_sent && wm0_w_done && wm0_owner && m0_bvalid) || (wm1_active && wm1_aw_sent && wm1_w_done && wm1_owner && m1_bvalid);
        s1_bid    = if s1_w_error_valid ? s1_aw_payload[48:45] : if wm1_active && wm1_owner ? m1_bid : m0_bid;
        s1_bresp  = if s1_w_error_valid ? 2'b11 : if wm1_active && wm1_owner ? m1_bresp : m0_bresp;

        // Read address decode and round-robin grants.
        rg01            = !rm0_active && s1_arvalid && !s1_r_busy && (s1_araddr <: 16'h4000) && (!(s0_arvalid && !s0_r_busy && (s0_araddr <: 16'h4000)) || rm0_rr);
        rg00            = !rm0_active && s0_arvalid && !s0_r_busy && (s0_araddr <: 16'h4000) && !rg01;
        rg11            = !rm1_active && s1_arvalid && !s1_r_busy && (s1_araddr >= 16'h8000) && (s1_araddr <: 16'hc000) && (!(s0_arvalid && !s0_r_busy && (s0_araddr >= 16'h8000) && (s0_araddr <: 16'hc000)) || rm1_rr);
        rg10            = !rm1_active && s0_arvalid && !s0_r_busy && (s0_araddr >= 16'h8000) && (s0_araddr <: 16'hc000) && !rg11;
        r_error_accept0 = s0_arvalid && !s0_r_busy && !((s0_araddr <: 16'h4000) || ((s0_araddr >= 16'h8000) && (s0_araddr <: 16'hc000)));
        r_error_accept1 = s1_arvalid && !s1_r_busy && !((s1_araddr <: 16'h4000) || ((s1_araddr >= 16'h8000) && (s1_araddr <: 16'hc000)));
        r_accept0       = rg00 || rg10 || r_error_accept0;
        r_accept1       = rg01 || rg11 || r_error_accept1;
        s0_arready      = r_accept0;
        s1_arready      = r_accept1;

        m0_arid          = rm0_ar_payload[48:45];
        m0_araddr        = rm0_ar_payload[44:29];
        m0_arlen         = rm0_ar_payload[28:21];
        m0_arsize        = rm0_ar_payload[20:18];
        m0_arburst       = rm0_ar_payload[17:16];
        m0_arlock        = rm0_ar_payload[15];
        m0_arcache       = rm0_ar_payload[14:11];
        m0_arprot        = rm0_ar_payload[10:8];
        m0_arqos         = rm0_ar_payload[7:4];
        m0_arregion      = rm0_ar_payload[3:0];
        m0_arvalid       = rm0_active && !rm0_ar_sent;
        m0_rready        = rm0_active && rm0_ar_sent && (if rm0_owner ? s1_rready : s0_rready);
        rm0_ar_handshake = m0_arvalid && m0_arready;
        rm0_done         = m0_rvalid && m0_rready && m0_rlast;

        m1_arid          = rm1_ar_payload[48:45];
        m1_araddr        = rm1_ar_payload[44:29];
        m1_arlen         = rm1_ar_payload[28:21];
        m1_arsize        = rm1_ar_payload[20:18];
        m1_arburst       = rm1_ar_payload[17:16];
        m1_arlock        = rm1_ar_payload[15];
        m1_arcache       = rm1_ar_payload[14:11];
        m1_arprot        = rm1_ar_payload[10:8];
        m1_arqos         = rm1_ar_payload[7:4];
        m1_arregion      = rm1_ar_payload[3:0];
        m1_arvalid       = rm1_active && !rm1_ar_sent;
        m1_rready        = rm1_active && rm1_ar_sent && (if rm1_owner ? s1_rready : s0_rready);
        rm1_ar_handshake = m1_arvalid && m1_arready;
        rm1_done         = m1_rvalid && m1_rready && m1_rlast;

        s0_rvalid          = s0_r_error_valid || (rm0_active && rm0_ar_sent && !rm0_owner && m0_rvalid) || (rm1_active && rm1_ar_sent && !rm1_owner && m1_rvalid);
        s0_rid             = if s0_r_error_valid ? s0_r_error_id : if rm1_active && !rm1_owner ? m1_rid : m0_rid;
        s0_rdata           = if s0_r_error_valid ? 32'h00000000 : if rm1_active && !rm1_owner ? m1_rdata : m0_rdata;
        s0_rresp           = if s0_r_error_valid ? 2'b11 : if rm1_active && !rm1_owner ? m1_rresp : m0_rresp;
        s0_rlast           = if s0_r_error_valid ? (s0_r_error_remaining == 8'h00) : if rm1_active && !rm1_owner ? m1_rlast : m0_rlast;
        s1_rvalid          = s1_r_error_valid || (rm0_active && rm0_ar_sent && rm0_owner && m0_rvalid) || (rm1_active && rm1_ar_sent && rm1_owner && m1_rvalid);
        s1_rid             = if s1_r_error_valid ? s1_r_error_id : if rm1_active && rm1_owner ? m1_rid : m0_rid;
        s1_rdata           = if s1_r_error_valid ? 32'h00000000 : if rm1_active && rm1_owner ? m1_rdata : m0_rdata;
        s1_rresp           = if s1_r_error_valid ? 2'b11 : if rm1_active && rm1_owner ? m1_rresp : m0_rresp;
        s1_rlast           = if s1_r_error_valid ? (s1_r_error_remaining == 8'h00) : if rm1_active && rm1_owner ? m1_rlast : m0_rlast;
        r_error_handshake0 = s0_r_error_valid && s0_rready;
        r_error_handshake1 = s1_r_error_valid && s1_rready;
    }

    always_ff (clk, rst_n) {
        if_reset {
            s0_aw_full           = 1'b0;
            s0_aw_payload        = 49'b0;
            s0_w_full            = 1'b0;
            s0_w_payload         = 37'b0;
            s0_w_busy            = 1'b0;
            s0_w_error_active    = 1'b0;
            s0_w_error_valid     = 1'b0;
            s1_aw_full           = 1'b0;
            s1_aw_payload        = 49'b0;
            s1_w_full            = 1'b0;
            s1_w_payload         = 37'b0;
            s1_w_busy            = 1'b0;
            s1_w_error_active    = 1'b0;
            s1_w_error_valid     = 1'b0;
            wm0_active           = 1'b0;
            wm0_owner            = 1'b0;
            wm0_aw_sent          = 1'b0;
            wm0_w_done           = 1'b0;
            wm0_aw_payload       = 49'b0;
            wm0_rr               = 1'b0;
            wm1_active           = 1'b0;
            wm1_owner            = 1'b0;
            wm1_aw_sent          = 1'b0;
            wm1_w_done           = 1'b0;
            wm1_aw_payload       = 49'b0;
            wm1_rr               = 1'b0;
            s0_r_busy            = 1'b0;
            s0_r_error_valid     = 1'b0;
            s0_r_error_id        = 4'b0;
            s0_r_error_remaining = 8'b0;
            s1_r_busy            = 1'b0;
            s1_r_error_valid     = 1'b0;
            s1_r_error_id        = 4'b0;
            s1_r_error_remaining = 8'b0;
            rm0_active           = 1'b0;
            rm0_owner            = 1'b0;
            rm0_ar_sent          = 1'b0;
            rm0_ar_payload       = 49'b0;
            rm0_rr               = 1'b0;
            rm1_active           = 1'b0;
            rm1_owner            = 1'b0;
            rm1_ar_sent          = 1'b0;
            rm1_ar_payload       = 49'b0;
            rm1_rr               = 1'b0;
        } else {
            if s0_awvalid && s0_awready {
                s0_aw_full    = 1'b1;
                s0_aw_payload = {
                    s0_awid, s0_awaddr, s0_awlen, s0_awsize,
                    s0_awburst, s0_awlock, s0_awcache, s0_awprot,
                    s0_awqos, s0_awregion
                };
            }
            if s1_awvalid && s1_awready {
                s1_aw_full    = 1'b1;
                s1_aw_payload = {
                    s1_awid, s1_awaddr, s1_awlen, s1_awsize,
                    s1_awburst, s1_awlock, s1_awcache, s1_awprot,
                    s1_awqos, s1_awregion
                };
            }
            if w_pop0 {
                s0_w_full = 1'b0;
            }
            if s0_wvalid && s0_wready {
                s0_w_full    = 1'b1;
                s0_w_payload = {s0_wdata, s0_wstrb, s0_wlast};
            }
            if w_pop1 {
                s1_w_full = 1'b0;
            }
            if s1_wvalid && s1_wready {
                s1_w_full    = 1'b1;
                s1_w_payload = {s1_wdata, s1_wstrb, s1_wlast};
            }

            if w_dispatch0 {
                s0_aw_full = 1'b0;
                s0_w_busy  = 1'b1;
            }
            if w_dispatch1 {
                s1_aw_full = 1'b0;
                s1_w_busy  = 1'b1;
            }
            if s0_bvalid && s0_bready {
                s0_w_busy        = 1'b0;
                s0_w_error_valid = 1'b0;
            }
            if s1_bvalid && s1_bready {
                s1_w_busy        = 1'b0;
                s1_w_error_valid = 1'b0;
            }
            if w_error_grant0 {
                s0_w_error_active = 1'b1;
            }
            if w_error_consume0 && s0_w_payload[0] {
                s0_w_error_active = 1'b0;
                s0_w_error_valid  = 1'b1;
            }
            if w_error_grant1 {
                s1_w_error_active = 1'b1;
            }
            if w_error_consume1 && s1_w_payload[0] {
                s1_w_error_active = 1'b0;
                s1_w_error_valid  = 1'b1;
            }

            if wg00 || wg01 {
                wm0_active     = 1'b1;
                wm0_owner      = wg01;
                wm0_aw_sent    = 1'b0;
                wm0_w_done     = 1'b0;
                wm0_aw_payload = if wg01 ? s1_aw_payload : s0_aw_payload;
            }
            if wm0_aw_handshake {
                wm0_aw_sent = 1'b1;
            }
            if wm0_w_handshake && m0_wlast {
                wm0_w_done = 1'b1;
            }
            if wm0_done {
                wm0_active = 1'b0;
                wm0_rr     = !wm0_owner;
            }
            if wg10 || wg11 {
                wm1_active     = 1'b1;
                wm1_owner      = wg11;
                wm1_aw_sent    = 1'b0;
                wm1_w_done     = 1'b0;
                wm1_aw_payload = if wg11 ? s1_aw_payload : s0_aw_payload;
            }
            if wm1_aw_handshake {
                wm1_aw_sent = 1'b1;
            }
            if wm1_w_handshake && m1_wlast {
                wm1_w_done = 1'b1;
            }
            if wm1_done {
                wm1_active = 1'b0;
                wm1_rr     = !wm1_owner;
            }

            if r_accept0 {
                s0_r_busy = 1'b1;
            }
            if r_accept1 {
                s1_r_busy = 1'b1;
            }
            if s0_rvalid && s0_rready && s0_rlast {
                s0_r_busy = 1'b0;
            }
            if s1_rvalid && s1_rready && s1_rlast {
                s1_r_busy = 1'b0;
            }
            if r_error_accept0 {
                s0_r_error_valid     = 1'b1;
                s0_r_error_id        = s0_arid;
                s0_r_error_remaining = s0_arlen;
            }
            if r_error_handshake0 {
                if s0_r_error_remaining == 8'h00 {
                    s0_r_error_valid = 1'b0;
                } else {
                    s0_r_error_remaining = s0_r_error_remaining - 8'h01;
                }
            }
            if r_error_accept1 {
                s1_r_error_valid     = 1'b1;
                s1_r_error_id        = s1_arid;
                s1_r_error_remaining = s1_arlen;
            }
            if r_error_handshake1 {
                if s1_r_error_remaining == 8'h00 {
                    s1_r_error_valid = 1'b0;
                } else {
                    s1_r_error_remaining = s1_r_error_remaining - 8'h01;
                }
            }

            if rg00 || rg01 {
                rm0_active     = 1'b1;
                rm0_owner      = rg01;
                rm0_ar_sent    = 1'b0;
                rm0_ar_payload = if rg01 ?
                    {
                        s1_arid, s1_araddr, s1_arlen, s1_arsize, s1_arburst,
                        s1_arlock, s1_arcache, s1_arprot, s1_arqos, s1_arregion
                    }
                :
                    {
                        s0_arid, s0_araddr, s0_arlen, s0_arsize, s0_arburst,
                        s0_arlock, s0_arcache, s0_arprot, s0_arqos, s0_arregion
                    }
                ;
            }
            if rm0_ar_handshake {
                rm0_ar_sent = 1'b1;
            }
            if rm0_done {
                rm0_active = 1'b0;
                rm0_rr     = !rm0_owner;
            }
            if rg10 || rg11 {
                rm1_active     = 1'b1;
                rm1_owner      = rg11;
                rm1_ar_sent    = 1'b0;
                rm1_ar_payload = if rg11 ?
                    {
                        s1_arid, s1_araddr, s1_arlen, s1_arsize, s1_arburst,
                        s1_arlock, s1_arcache, s1_arprot, s1_arqos, s1_arregion
                    }
                :
                    {
                        s0_arid, s0_araddr, s0_arlen, s0_arsize, s0_arburst,
                        s0_arlock, s0_arcache, s0_arprot, s0_arqos, s0_arregion
                    }
                ;
            }
            if rm1_ar_handshake {
                rm1_ar_sent = 1'b1;
            }
            if rm1_done {
                rm1_active = 1'b0;
                rm1_rr     = !rm1_owner;
            }
        }
    }
}
